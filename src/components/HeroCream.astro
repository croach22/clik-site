---
// Hero — engine/throughput ethos. Radial glow + dot-grid atmosphere,
// staggered load-in, proof row under the CTAs so trust lands above the fold.
// Headline stays input-agnostic (shoots, podcasts, clip folders) so clipping
// isn't alienated; the subhead does the differentiating — "sorts, plans" is
// the wedge nobody else can claim.
// Visual: HeroLoop — code-built inputs → hub → fan-out loop.
import HeroLoop from './HeroLoop';
const CALENDLY_URL = 'https://calendly.com/clikphotos/clik-agency-demo';

const proofFaces = [
  { src: '/images/testimonials/matt-ragland.jpg', alt: 'Matt Ragland' },
  { src: '/images/testimonials/gigi-robinson.jpg', alt: 'Gigi Robinson' },
  { src: '/images/testimonials/randy-stoever.jpg', alt: 'Randy Stoever' },
];
---

<section id="hero" class="relative overflow-hidden pt-32 md:pt-36">
  <!-- atmosphere -->
  <div class="dot-grid absolute inset-x-0 top-0 h-[620px]" aria-hidden="true"></div>
  <div
    class="glow -top-24 left-[-10%] h-[480px] w-[720px]"
    style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.14), transparent 72%);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[1200px] px-6 md:px-12 pb-14">

    <div class="w-full py-8 md:py-10">
      <!-- Kicker — vertical accent bar, systems language -->
      <div class="flex items-center gap-3" data-reveal style="--reveal-delay: 0ms;">
        <span class="h-4 w-[3px] rounded-full bg-clik-royce" aria-hidden="true"></span>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
          AI-Powered Content Ops
        </p>
      </div>

      <!-- Headline -->
      <h1
        class="mt-6 font-display font-medium tracking-display text-clik-cream"
        style="font-size: clamp(44px, 8vw, 72px); line-height: 1.02; letter-spacing: -0.02em; max-width: 20ch; --reveal-delay: 80ms;"
        data-reveal
      >
        An on-brand content engine for any video input<span class="clik-period">.</span>
      </h1>

      <!-- Body -->
      <p
        class="mt-6 max-w-[620px] font-ui text-clik-cream/70"
        style="font-size: 18px; line-height: 1.55; --reveal-delay: 160ms;"
        data-reveal
      >
        Point it at a shoot, a podcast, or a folder of clips. It sorts, plans, and builds — and gets sharper every project.
      </p>

      <!-- CTAs — self-serve + teams who want a conversation first -->
      <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 240ms;">
        <a href="https://app.clik.vision/sign-up" class="clik-btn clik-btn-primary">
          Start for free <span aria-hidden="true">→</span>
        </a>
        <a href={CALENDLY_URL} class="clik-btn clik-btn-secondary">
          Book a demo
        </a>
      </div>

      <!-- Proof row — trust above the fold -->
      <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 320ms;">
        <div class="flex -space-x-2">
          {proofFaces.map((f) => (
            <img
              src={f.src}
              alt={f.alt}
              class="h-7 w-7 rounded-full object-cover ring-2 ring-[#0E1834]"
              loading="eager"
            />
          ))}
        </div>
        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/50">
          Runs content for Feed Studios, MAE Media &amp; top creators
        </p>
      </div>
    </div>

    <!-- Hero visual — looping inputs → engine → fan-out animation, with
         flowing line-art garnish converging into the card from both sides -->
    <div class="relative mt-10 md:mt-14">
      <div
        class="glow left-1/2 top-1/2 h-[130%] w-[110%] -translate-x-1/2 -translate-y-1/2"
        style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.10), transparent 74%);"
        aria-hidden="true"
      ></div>
      <svg
        class="pointer-events-none absolute -left-24 top-1/2 hidden w-64 -translate-y-1/2 md:block"
        viewBox="0 0 260 200"
        fill="none"
        aria-hidden="true"
      >
        {[0, 1, 2, 3, 4].map((i) => (
          <path
            d={`M0 ${30 + i * 35} C 120 ${30 + i * 35}, 160 ${100 - i * 4}, 260 ${96 + i * 2}`}
            stroke="#5481E8"
            stroke-opacity={0.28 - i * 0.04}
            stroke-width="1.2"
          />
        ))}
      </svg>
      <svg
        class="pointer-events-none absolute -right-24 top-1/2 hidden w-64 -translate-y-1/2 md:block"
        viewBox="0 0 260 200"
        fill="none"
        aria-hidden="true"
      >
        {[0, 1, 2, 3, 4].map((i) => (
          <path
            d={`M260 ${30 + i * 35} C 140 ${30 + i * 35}, 100 ${100 - i * 4}, 0 ${96 + i * 2}`}
            stroke="#F9838E"
            stroke-opacity={0.22 - i * 0.035}
            stroke-width="1.2"
          />
        ))}
      </svg>
      <HeroLoop client:load />
    </div>
  </div>
</section>
