---
// Final CTA — brand-led moment on midnight surface. Restates the promise.
// Two buttons split self-serve from teams who want a conversation first.
const CALENDLY_URL = 'https://calendly.com/clikphotos/clik-agency-demo';

// one finished video per input type, so the closing frame shows the range
const outputs = [
  { label: 'shoot day', src: '/videos/showcase/content-day/out-a.mp4', accent: '#5481E8' },
  { label: 'interview', src: '/videos/showcase/street-interviews/out-a.mp4', accent: '#F9838E' },
  { label: 'yap batch', src: '/videos/showcase/yap-batch/out-a.mp4', accent: '#7CA088' },
];
---

<section id="cta" class="px-6 md:px-12 py-20 md:py-32">
  <div class="mx-auto max-w-[1200px]">
    <div class="clik-section-header mb-8">
      <span class="idx">[ 08 ]</span>
      <span class="rule"></span>
      <span class="label">SHIP MORE</span>
    </div>
    <div
      class="on-midnight relative overflow-hidden"
      style="background: #13204A; border: 1px solid rgba(249, 247, 241, 0.10); border-radius: 12px; padding: clamp(48px, 7vw, 96px) clamp(24px, 5vw, 64px); color: var(--clik-cream);"
    >
      <div
        class="glow -left-32 -top-32 h-[420px] w-[640px]"
        style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.20), transparent 72%);"
        aria-hidden="true"
      ></div>
      <div
        class="glow -bottom-40 -right-24 h-[420px] w-[560px]"
        style="background: radial-gradient(closest-side, rgba(249, 131, 142, 0.12), transparent 72%);"
        aria-hidden="true"
      ></div>

      <!-- Three real outputs, one per input type — the abstract fan said
           "many things come out"; these say what actually comes out. -->
      <div class="absolute right-12 top-1/2 hidden -translate-y-1/2 items-center gap-3 lg:flex" aria-hidden="true">
        {outputs.map((o, i) => (
          <div
            class="relative overflow-hidden rounded-lg"
            style={`width: 108px; aspect-ratio: 9 / 16; border: 1px solid ${o.accent}66; box-shadow: 0 18px 40px rgba(4, 8, 22, 0.5); transform: translateY(${i % 2 ? 10 : -10}px);`}
          >
            <video
              src={o.src}
              class="absolute inset-0 h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
            <span
              class="absolute inset-x-0 bottom-0 block px-1.5 py-1 font-mono uppercase"
              style="font-size: 7.5px; letter-spacing: 0.1em; color: rgba(249,247,241,.8); background: rgba(6,11,26,.8);"
            >
              {o.label}
            </span>
          </div>
        ))}
      </div>

      <h2 class="font-display font-medium text-clik-cream" style="font-size: clamp(40px, 6vw, 68px); line-height: 1; letter-spacing: -0.02em; max-width: 14ch;">
        3x your output without hiring<span class="clik-period">.</span>
      </h2>
      <p class="mt-6 max-w-[52ch] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.55;">
        Run your first project free. No credit card required.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="https://app.clik.vision/sign-up" class="clik-btn clik-btn-light">
          Start for free <span aria-hidden="true">→</span>
        </a>
        <a href={CALENDLY_URL} class="clik-btn cta-ghost">
          Book a demo
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ghost secondary on the midnight surface — cream-bordered */
  .cta-ghost {
    background: transparent;
    color: var(--clik-cream);
    border: 1px solid var(--clik-cream-25);
  }
  .cta-ghost:hover {
    border-color: var(--clik-cream);
  }
</style>
