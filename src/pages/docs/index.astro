---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getAllDocs, GROUP_ORDER } from '../../lib/notion';

const allDocs = await getAllDocs();
const featured = allDocs.filter(d => d.featured);

const groupMeta: Record<string, { description: string }> = {
  'Getting Started': { description: 'Create your first project, upload footage, and get up to speed fast.' },
  'Editing': { description: 'Use AI to edit by conversation, add clips, and manage your timeline.' },
  'Workflows': { description: 'Run multi-step creative workflows and write prompts that get better results.' },
  'Captioning and Exports': { description: 'Generate captions, style them, and export your finished video.' },
};
---

<DocsLayout title="Clik Docs" description="Learn how to use Clik — upload footage, edit with AI, export your finished video.">

  <div class="pt-6 pb-14 border-b border-clik-midnight/12">
    <h1 class="font-display font-medium text-clik-midnight mb-4 leading-tight" style="font-size: clamp(32px, 4.5vw, 44px); letter-spacing: -0.02em;">Clik Documentation</h1>
    <p class="font-ui text-clik-midnight/70 text-base leading-relaxed max-w-xl mb-8">Everything you need to upload footage, edit with AI, and export a finished video.</p>
    <div class="flex flex-wrap items-center gap-3">
      <a href={`/docs/${(featured[0] || allDocs[0])?.slug}`} class="clik-btn clik-btn-primary">
        Get started <span aria-hidden="true">→</span>
      </a>
      <a href="#categories" class="clik-btn clik-btn-secondary">
        Browse all topics
      </a>
    </div>
  </div>

  <div id="categories" class="pt-12">
    <p class="mb-6 font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/55">Explore by category</p>
    <div class="grid gap-3 sm:grid-cols-3">
      {GROUP_ORDER.map(group => {
        const meta = groupMeta[group] ?? { description: '' };
        const docs = allDocs.filter(d => d.group === group);
        const firstDoc = docs[0];
        if (!firstDoc) return null;
        return (
          <a href={`/docs/${firstDoc.slug}`} class="group rounded-xl border border-clik-midnight/10 bg-clik-cream p-5 hover:border-clik-royce/40 transition-colors">
            <div class="mb-4 h-9 w-9 rounded-lg bg-clik-royce/10 border border-clik-royce/25 flex items-center justify-center text-clik-royce">
              {group === 'Getting Started' && <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1.5L11 6.5H16.5L12 9.5L13.5 15L9 12L4.5 15L6 9.5L1.5 6.5H7L9 1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>}
              {group === 'Editing' && <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2.5 15L7 10M7 10L12 5L13.5 6.5M7 10L8 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 5L13 3.5L15 5.5L14 7M12 5L13.5 6.5M13.5 6.5L14 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              {group === 'Workflows' && <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="1.4"/><circle cx="14" cy="4" r="2" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="14" r="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 6v2a2 2 0 002 2h6a2 2 0 002-2V6M9 10v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>}
              {group === 'Captioning and Exports' && <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="1.5" y="4" width="15" height="10" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M4.5 8h5M4.5 11h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>}
            </div>
            <p class="font-display font-medium text-clik-midnight mb-1.5" style="font-size: 15px; letter-spacing: -0.01em;">{group}</p>
            <p class="font-ui text-xs text-clik-midnight/55 leading-relaxed">{meta.description}</p>
          </a>
        );
      })}
    </div>
  </div>

  {featured.length > 0 && (
    <div class="mt-14">
      <p class="mb-5 font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/55">Quick start</p>
      <div class="divide-y divide-clik-midnight/8 rounded-xl border border-clik-midnight/10 overflow-hidden">
        {featured.map(doc => (
          <a href={`/docs/${doc.slug}`} class="group flex items-center justify-between px-4 py-3.5 hover:bg-clik-midnight/5 transition-colors">
            <div>
              <p class="font-ui text-sm font-bold text-clik-midnight group-hover:text-clik-royce transition-colors">{doc.title}</p>
              <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/45 mt-1">{doc.group}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-clik-midnight/45 group-hover:text-clik-royce shrink-0 transition-colors"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        ))}
      </div>
    </div>
  )}

</DocsLayout>
