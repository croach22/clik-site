---
// How teams actually use Clik — three cards covering the range, from the main
// page through paid testing to secondary accounts. Replaces the single
// fan-page card, which only told the third of these stories.
const CARD = 'border-color: rgba(249, 247, 241, 0.10); background: rgba(249, 247, 241, 0.03);';

const uses = [
  {
    chip: 'Main page',
    accent: '#5481E8',
    title: 'Scale the page you already care about',
    body: 'Clik gets you 90% done videos instantly. Your trusted team reviews and polishes, so your main account stops waiting on edit time.',
  },
  {
    chip: 'Paid + testing',
    accent: '#F9838E',
    title: 'Test more variations than you could shoot',
    body: 'Variation workflows get 5x the use out of any video concept. More views per concept, and you find the winning hook structures faster.',
  },
  {
    chip: 'Secondary pages',
    accent: '#9785B8',
    title: 'Run fan and community accounts on autopilot',
    body: 'Point the same engine at the accounts you never have time for. Same brand rules, no clippers to hire and manage.',
  },
];
---

<section id="autopilot" class="px-6 md:px-12 py-24 md:py-32">
  <div class="mx-auto max-w-[1200px]">
    <div class="clik-section-header">
      <span class="idx">[ 04 ]</span>
      <span class="rule"></span>
      <span class="label">IN PRACTICE</span>
    </div>

    <h2
      class="font-display font-medium text-clik-cream"
      style="font-size: clamp(36px, 4.5vw, 46px); line-height: 1.1; letter-spacing: -0.02em;"
    >
      How teams use their content engine<span class="clik-period">.</span>
    </h2>
    <p class="mt-5 font-ui text-clik-cream/70" style="font-size: 17px; line-height: 1.55; max-width: 92ch;">
      Same engine, pointed at three different problems. Most teams start with the first one and grow into the others.
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {uses.map((u) => (
        <div class="bento-card border flex flex-col" style={`${CARD} padding: 28px;`}>
          <span
            class="clik-chip self-start"
            style={`background: ${u.accent}14; border-color: ${u.accent}45; color: ${u.accent};`}
          >
            {u.chip}
          </span>

          <h3
            class="mt-5 font-display font-medium text-clik-cream"
            style="font-size: clamp(20px, 2.2vw, 23px); line-height: 1.2; letter-spacing: -0.01em;"
          >
            {u.title}<span class="clik-period">.</span>
          </h3>

          <p class="mt-3 font-ui text-clik-cream/70" style="font-size: 15px; line-height: 1.6;">
            {u.body}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <p class="font-ui text-clik-cream/55" style="font-size: 15px;">
        One engine covers all three. You don't pick a lane.
      </p>
      <a
        href="https://app.clik.vision/sign-up"
        class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce no-underline hover:opacity-80"
      >
        Start with your main page <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
