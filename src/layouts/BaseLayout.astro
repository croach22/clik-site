---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import NavCream from '../components/NavCream.astro';
import Footer from '../components/Footer.astro';
import MobileEmailDrawer from '../components/MobileEmailDrawer';
import FloatingCTA from '../components/FloatingCTA.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'dark' | 'cream' | 'midnight'; // midnight = cream components on a dark bento surface
}
const { title, description = 'Clik — an on-brand content engine for any video input.', theme = 'dark' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Open Graph / Link Previews -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://clik.vision" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://clik.vision/og-image-v6.png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://clik.vision/og-image-v6.png" />

  <!-- PostHog -->
  <script>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageviewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
  posthog.init('phc_OUaH4Cu6n3LjVzTD9Sl7VWWS8KXrqWxaSjCvBCxp4xU', {
    api_host: 'https://us.i.posthog.com',
    person_profiles: 'identified_only',
    capture_pageview: true,
    capture_pageleave: true,
    autocapture: true
  });
  </script>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4JCH65ZKBX"></script>
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-4JCH65ZKBX');
  </script>


  <!-- Meta Pixel -->
  <script>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '754145170241342');
  fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=754145170241342&ev=PageView&noscript=1"
  /></noscript>
</head>
<body
  class={theme === 'cream' ? 'theme-cream' : theme === 'midnight' ? 'theme-cream theme-midnight' : ''}
  data-theme={theme}
>

  {theme === 'cream' || theme === 'midnight' ? <NavCream theme={theme} /> : <Nav />}
  <slot />
  <Footer />
  <FloatingCTA />
  <MobileEmailDrawer client:load />
  <script>
    // Scroll-reveal (midnight theme only) — stamps [data-reveal] on section
    // furniture and fades it up on first viewport entry, staggered per parent.
    // React islands' internal animations are untouched; this only moves the
    // static shells.
    if (
      document.body.classList.contains('theme-midnight') &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      'IntersectionObserver' in window
    ) {
      const SELECTORS = [
        '.clik-section-header',
        'section h2',
        '.bento-card',
        '.clik-card',
        '.comparison-grid',
        '.faq-item',
        '.stat-cell',
        '.reveal-me',
      ].join(', ');

      const els = Array.from(document.querySelectorAll<HTMLElement>(SELECTORS));
      // stagger siblings that share a parent
      const parentCounts = new Map<Element, number>();
      els.forEach((el) => {
        // Never stamp inside React islands — attributes added before hydration
        // trigger mismatch warnings, and the islands animate themselves.
        if (el.closest('astro-island')) return;
        if (el.hasAttribute('data-reveal')) return;
        const parent = el.parentElement;
        const idx = parent ? (parentCounts.get(parent) ?? 0) : 0;
        if (parent) parentCounts.set(parent, idx + 1);
        el.setAttribute('data-reveal', '');
        el.style.setProperty('--reveal-delay', `${Math.min(idx, 5) * 70}ms`);
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-inview');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -5% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    }
  </script>
  <script>
    import { trackMetaEvent } from '../lib/analytics';

    // Fire AgencyPageView once the agency page loads (custom event — stronger
    // optimization signal than the vanilla PageView already fired by the Pixel snippet).
    if (location.pathname.startsWith('/use-cases/agencies')) {
      trackMetaEvent('AgencyPageView', { audience: 'agency', surface: 'agency-page' });
    }
    if (location.pathname.startsWith('/use-cases/creators')) {
      trackMetaEvent('CreatorPageView', { audience: 'creator', surface: 'creator-page' });
    }

    // Delegated click tracking via [data-track-click="EventName"].
    // Optional [data-track-params='{"audience":"agency"}'] for custom params.
    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement)?.closest?.('[data-track-click]') as HTMLElement | null;
      if (!el) return;
      const eventName = el.getAttribute('data-track-click');
      if (!eventName) return;
      let params: Record<string, unknown> = {};
      const raw = el.getAttribute('data-track-params');
      if (raw) {
        try { params = JSON.parse(raw); } catch { /* malformed JSON — ignore */ }
      }
      trackMetaEvent(eventName, params);
    });

    // Delegated view tracking via [data-track-view="EventName"] using
    // IntersectionObserver. Each event fires at most once per session
    // (sessionStorage flag) so it survives in-page scrolls.
    const trackViewEls = document.querySelectorAll<HTMLElement>('[data-track-view]');
    if (trackViewEls.length && 'IntersectionObserver' in window) {
      const viewObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const eventName = el.getAttribute('data-track-view');
          if (!eventName) return;
          const sessionKey = `mt-view:${eventName}`;
          if (sessionStorage.getItem(sessionKey)) {
            viewObserver.unobserve(el);
            return;
          }
          sessionStorage.setItem(sessionKey, '1');
          let params: Record<string, unknown> = {};
          const raw = el.getAttribute('data-track-params');
          if (raw) {
            try { params = JSON.parse(raw); } catch { /* malformed — ignore */ }
          }
          trackMetaEvent(eventName, params);
          viewObserver.unobserve(el);
        });
      }, { threshold: 0.5 });
      trackViewEls.forEach((el) => viewObserver.observe(el));
    }

    // On mobile, intercept sign-up links and show the email drawer instead.
    // Capture phase, so a React island that stops propagation (the hero prompt
    // modal, any use-case CTA) can't swallow the click before we see it. This
    // cancels the navigation, not the event, so [data-track-click] still fires.
    // matchMedia rather than innerWidth > 768: Tailwind's md is min-width 768,
    // so at exactly 768 the desktop layout is up and the drawer should not be.
    document.addEventListener('click', (e) => {
      if (!window.matchMedia('(max-width: 767px)').matches) return;
      const link = (e.target as HTMLElement)?.closest?.('a[href*="sign-up"]');
      if (link && window.__openEmailDrawer) {
        e.preventDefault();
        window.__openEmailDrawer();
      }
    }, true);

    // Smooth-scroll for same-page hash links.
    document.addEventListener('click', (e) => {
      // Respect modifier keys (cmd/ctrl/shift = open in new tab) and middle-click
      const me = e as MouseEvent;
      if (me.metaKey || me.ctrlKey || me.shiftKey || me.altKey || me.button !== 0) return;
      const a = (e.target as HTMLElement)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
      if (!a) return;
      if (a.target === '_blank' || a.hasAttribute('download')) return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
      const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.pushState(null, '', url.hash);
    });

    // Track CTA clicks
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a[href*="sign-up"]');
      if (link && window.posthog) {
        const section = link.closest('section, nav, header')?.getAttribute('id')
          || link.closest('section, nav, header')?.tagName.toLowerCase()
          || 'unknown';
        window.posthog.capture('cta_clicked', {
          button_text: link.textContent?.trim(),
          location: section,
        });
      }
    });

    // Track section visibility (fires once per section per page load)
    const seen = new Set<string>();
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('data-section') || entry.target.id;
          if (id && !seen.has(id) && window.posthog) {
            seen.add(id);
            window.posthog.capture('section_viewed', { section_name: id });
          }
        }
      });
    }, { threshold: 0.3 });

    // Observe all top-level sections
    requestAnimationFrame(() => {
      document.querySelectorAll('[data-section]').forEach((el) => observer.observe(el));
    });
  </script>

  {/* ── Dev-only copy editing ────────────────────────────────────────────
       Cmd/Ctrl+E turns the page into a text document. Type anywhere, then
       hit Copy to get every change as old → new with the section it came
       from, which is enough to apply it back to source exactly.

       Gated on import.meta.env.DEV, so none of this reaches a build. ── */}
  {import.meta.env.DEV && (
    <script is:inline>
      (() => {
        const LEAF =
          'p, h1, h2, h3, h4, h5, li, summary, blockquote, figcaption, td, th, a, button, span';
        const original = new Map();
        let on = false;

        // Snapshot text once, so we can diff against it later. "Leaf" has to
        // tolerate decorative children — headlines carry a .clik-period span —
        // so an element counts as a leaf when no child holds real text.
        const holdsText = (el) =>
          Array.from(el.children).some((c) => c.textContent.trim().length > 2);

        const snapshot = () => {
          document.querySelectorAll(LEAF).forEach((el) => {
            if (holdsText(el)) return;
            const t = el.textContent.trim();
            if (t && !original.has(el)) original.set(el, t);
          });
        };

        const sectionOf = (el) => {
          const s = el.closest('[data-section]') || el.closest('section[id]');
          return s ? s.dataset.section || s.id : 'page';
        };

        const changes = () => {
          const out = [];
          original.forEach((was, el) => {
            if (!el.isConnected) return;
            const now = el.textContent.trim();
            if (now !== was) out.push(`[${sectionOf(el)}] "${was}"\n        -> "${now}"`);
          });
          return out;
        };

        const pill = document.createElement('div');
        pill.style.cssText =
          'position:fixed;left:16px;bottom:16px;z-index:99999;display:none;gap:10px;' +
          'align-items:center;padding:8px 12px;border-radius:10px;font:600 11px/1 ui-monospace,monospace;' +
          'letter-spacing:.1em;text-transform:uppercase;color:#0E1834;background:#F9F7F1;' +
          'box-shadow:0 8px 30px rgba(0,0,0,.4)';
        pill.setAttribute('contenteditable', 'false');
        pill.innerHTML =
          '<span>Editing</span><button id="clik-copy" style="all:unset;cursor:pointer;' +
          'padding:4px 8px;border-radius:6px;background:#5481E8;color:#F9F7F1">Copy changes</button>';
        document.body.appendChild(pill);

        // mousedown, because designMode swallows click on editable surfaces
        pill.querySelector('#clik-copy').addEventListener('mousedown', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const list = changes();
          const text = list.length ? list.join('\n\n') : '(no changes yet)';
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            /* clipboard can be blocked; the log below is the fallback */
          }
          console.log('%c[clik] copy changes\n' + text, 'color:#5481E8');
          const b = pill.querySelector('#clik-copy');
          b.textContent = list.length ? `Copied ${list.length}` : 'Nothing yet';
          setTimeout(() => (b.textContent = 'Copy changes'), 1600);
        });

        const setMode = (next) => {
          on = next;
          if (on) snapshot();
          document.designMode = on ? 'on' : 'off';
          pill.style.display = on ? 'flex' : 'none';
        };

        document.addEventListener('keydown', (e) => {
          // Escape always exits, so it's never possible to get stuck in a
          // page where nothing clicks.
          if (e.key === 'Escape' && on) {
            e.preventDefault();
            setMode(false);
            return;
          }
          if (!(e.key === 'e' || e.key === 'E') || !(e.metaKey || e.ctrlKey)) return;
          e.preventDefault();
          setMode(!on);
        });

        window.clikEdits = () => {
          const list = changes();
          const text = list.length ? list.join('\n\n') : '(no changes yet)';
          console.log('%c[clik] ' + list.length + ' change(s)\n' + text, 'color:#5481E8');
          return text;
        };

        console.log('%c[clik] Cmd/Ctrl+E to edit copy · clikEdits() to dump changes', 'color:#5481E8');
      })();
    </script>
  )}
</body>
</html>
