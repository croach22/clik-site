---
// Edit Agent — kit-style feature: numbered header, Fraunces title,
// body + KV metadata block on left, bracket-framed terminal demo on right.
const kv = [
  ['JOB',       'EDIT AGENT'],
  ['INPUT',     'RAW FOOTAGE'],
  ['OUTPUT',    'PUBLISH-READY DRAFT'],
  ['EDITING',   'CONVERSATIONAL'],
  ['SCRUBBING', 'NONE'],
  ['SOURCE',    'UNTOUCHED'],
  ['VIBES',     'DIRECTOR'],
];
---

<section id="features" class="px-6 md:px-12 py-24 md:py-32">
  <div class="mx-auto max-w-[1200px]">
    <div class="clik-section-header">
      <span class="idx">[ 01 ]</span>
      <span class="rule"></span>
      <span class="label">EDIT AGENT</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-display font-medium text-clik-midnight" style="font-size: clamp(36px, 4.5vw, 46px); line-height: 1.05; letter-spacing: -0.02em;">
          Raw footage in.<br/>Rough draft out<span class="clik-period">.</span>
        </h2>
        <p class="mt-5 max-w-[48ch] font-ui text-clik-midnight/70" style="font-size: 18px; line-height: 1.55;">
          Talk to your footage. Tighten the intro, swap the hook, cut the dead space — Clik does the work and you stay creative. Find missing moments with AI Search. Add viral captions in one click.
        </p>
        <div class="clik-kv mt-8 max-w-[380px]">
          {kv.map(([k, v]) => (
            <div class={`row ${k === 'VIBES' ? 'vibes' : ''}`}>
              <span>{k}</span><span class="v">{v}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Terminal demo -->
      <div>
        <div
          class="clik-frame relative bg-clik-bone"
          style="color: var(--clik-midnight); border-radius: 2px; padding: 28px 26px;"
        >
          <span class="clik-corner-tr"></span>
          <span class="clik-corner-bl"></span>

          <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-salmon mb-4">
            SCENE 02 · TAKE 04
          </div>
          <div class="font-mono text-[13px] leading-[1.9] text-clik-midnight">
            <div><span class="text-clik-salmon">›</span> tighten the intro</div>
            <div class="text-clik-royce flex items-center gap-1">
              <span class="inline-block animate-spin">↻</span> generating · 00:00:08:23
            </div>
            <div class="text-clik-midnight/55">✓ removed 0:00–0:04 · 4.2s saved</div>
            <div class="mt-3"><span class="text-clik-salmon">›</span> swap the hook</div>
            <div class="text-clik-midnight/55">✓ moved B-roll 1:24 → 0:00 · 11.8s reordered</div>
            <div class="mt-3"><span class="text-clik-salmon">›</span> cut the dead space at 0:15</div>
            <div class="text-clik-midnight/55">✓ trimmed 0:14–0:18 · 3.7s saved</div>
          </div>
          <div class="mt-5 font-mono text-[9px] uppercase tracking-[0.14em] text-clik-midnight/45">
            SOURCE: SESSION_07
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes _clik_spin { to { transform: rotate(360deg); } }
  .animate-spin { animation: _clik_spin 0.9s linear infinite; display: inline-block; }
</style>
