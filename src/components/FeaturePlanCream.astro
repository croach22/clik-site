---
// Brainstorm Agent — kit-style feature: chat-style terminal demo on right.
const kv = [
  ['JOB',       'BRAINSTORM AGENT'],
  ['INPUT',     'AN IDEA'],
  ['OUTPUT',    'SCRIPT + SHOT LIST'],
  ['EDITING',   'CONVERSATIONAL'],
  ['SCRUBBING', 'NONE'],
  ['SOURCE',    'UNTOUCHED'],
  ['VIBES',     'CREATIVE TEAM'],
];

const shotList = [
  'Cutting an onion — top down, halfway through',
  'Move camera to a front-on shot',
  'Grating carrots — start to finish',
];
---

<section id="feature-plan" class="px-6 md:px-12 py-24 md:py-32">
  <div class="mx-auto max-w-[1200px]">
    <div class="clik-section-header">
      <span class="idx">[ 03 ]</span>
      <span class="rule"></span>
      <span class="label">BRAINSTORM AGENT</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-display font-medium text-clik-midnight" style="font-size: clamp(36px, 4.5vw, 46px); line-height: 1.05; letter-spacing: -0.02em;">
          Like having a creative<br/>team behind you<span class="clik-period">.</span>
        </h2>
        <p class="mt-5 max-w-[48ch] font-ui text-clik-midnight/70" style="font-size: 18px; line-height: 1.55;">
          Your AI creative strategist helps you brainstorm ideas, write scripts, and build shot lists — so when you hit record, you know exactly what to shoot.
        </p>
        <div class="clik-kv mt-8 max-w-[380px]">
          {kv.map(([k, v]) => (
            <div class={`row ${k === 'VIBES' ? 'vibes' : ''}`}>
              <span>{k}</span><span class="v">{v}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Chat-style terminal -->
      <div>
        <div
          class="clik-frame relative bg-clik-bone"
          style="color: var(--clik-midnight); border-radius: 2px; padding: 28px 26px;"
        >
          <span class="clik-corner-tr"></span>
          <span class="clik-corner-bl"></span>

          <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-salmon mb-4">
            SESSION 12 · DRAFT 03
          </div>

          <div class="font-mono text-[12px] leading-[1.85] text-clik-midnight space-y-3">
            <div>
              <div class="text-clik-midnight/45 text-[10px] uppercase tracking-[0.14em] mb-1">YOU</div>
              <div>I want to start cooking content but don't know where to begin.</div>
            </div>

            <div>
              <div class="text-clik-royce text-[10px] uppercase tracking-[0.14em] mb-1">CLIK</div>
              <div class="text-clik-midnight/80">
                Voiceover is easier — film the cooking, narrate later. What are you making?
              </div>
            </div>

            <div>
              <div class="text-clik-midnight/45 text-[10px] uppercase tracking-[0.14em] mb-1">YOU</div>
              <div>Bolognese.</div>
            </div>

            <div>
              <div class="text-clik-royce text-[10px] uppercase tracking-[0.14em] mb-1">CLIK · SHOT LIST</div>
              <div class="space-y-1 mt-1">
                {shotList.map((shot, i) => (
                  <div class="flex gap-2 text-clik-midnight/80">
                    <span class="text-clik-royce/60">{String(i + 1).padStart(2, '0')}</span>
                    <span>{shot}</span>
                  </div>
                ))}
                <div class="text-clik-midnight/45 text-[10px] mt-2 pt-2 border-t border-clik-midnight/10">
                  + 9 MORE SHOTS · VIEW FULL LIST →
                </div>
              </div>
            </div>
          </div>

          <div class="mt-5 font-mono text-[9px] uppercase tracking-[0.14em] text-clik-midnight/45">
            STATUS: SHIPPING
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
