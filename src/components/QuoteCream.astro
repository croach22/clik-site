---
// Cream Quote section — kit pattern: hero bracket-framed quote +
// marquee of supporting quotes underneath, all in cream surface w/ mono attribution.
const hero = {
  quote: "This just turned an 8 hour edit process into 2. I went from opening my computer to posting on YouTube in 2 hours. It was magical.",
  author: "MATT RAGLAND",
  handle: "YOUTUBER",
  scene: "SCENE 02 · TAKE 04",
  date: "REC 03.18.2026",
};

const others = [
  { quote: "Finding good editors is the only reason I can't scale. Clik solves that problem.", author: "CONTENT AGENCY", handle: "$30K MRR" },
  { quote: "This totally changes how we work. With drafts ready instantly, our creative directors take projects deeper and iterate faster. Our editors just make finishing touches. Now we can scale without hiring more editors.", author: "FEED STUDIOS LA", handle: "CONTENT AGENCY" },
  { quote: "This will totally change how people create content.", author: "ZACH NEMAN", handle: "@CHEFFINWITHZACH" },
  { quote: "Clik has completely changed not only how I edit but how I film. What used to take over two hours now takes 20 minutes, and I enjoy the entire process around cooking content much more now.", author: "RANDY STOEVER", handle: "@HOTOFFTHESTOEVER" },
  { quote: "I've tried so many AI content tools; Clik is my favorite by far.", author: "GIGI ROBINSON", handle: "@ITSGIGIROBINSON" },
];
---

<section class="px-6 md:px-12 py-24 md:py-32 overflow-hidden">
  <div class="mx-auto max-w-[1100px]">
    <!-- Hero quote — bracket-framed window -->
    <div
      class="clik-frame relative"
      style="color: var(--clik-midnight); padding: 56px clamp(24px, 5vw, 64px);"
    >
      <span class="clik-corner-tr"></span>
      <span class="clik-corner-bl"></span>

      <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-salmon mb-6">
        {hero.scene}
      </div>
      <p
        class="font-display font-medium italic text-clik-midnight"
        style="font-size: clamp(24px, 3vw, 32px); line-height: 1.3; letter-spacing: -0.01em; max-width: 24ch;"
      >
        "{hero.quote}"
      </p>
      <div class="mt-8 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-midnight/70">
        {hero.author} · {hero.handle}
      </div>
      <div class="absolute bottom-4 right-6 font-mono text-[9px] uppercase tracking-[0.14em] text-clik-midnight/45">
        {hero.date}
      </div>
    </div>
  </div>

  <!-- Supporting marquee -->
  <div class="mt-16 marquee-row">
    <div class="marquee-track">
      {[...others, ...others, ...others].map((t) => (
        <div
          class="marquee-card flex-shrink-0 w-[360px] clik-frame relative bg-clik-cream"
          style="color: var(--clik-midnight); padding: 24px;"
        >
          <span class="clik-corner-tr"></span>
          <span class="clik-corner-bl"></span>
          <p class="font-ui text-clik-midnight" style="font-size: 15px; line-height: 1.55;">"{t.quote}"</p>
          <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/55">
            {t.author} · {t.handle}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-row {
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: clik-marquee 60s linear infinite;
  }
  .marquee-row:hover .marquee-track { animation-play-state: paused; }
  @keyframes clik-marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
</style>
