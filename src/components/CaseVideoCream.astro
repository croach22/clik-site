---
// Bobby / MAE Media, on its own after the system section: the engine has just
// been explained, so this is where a real operator saying it works lands
// hardest. Deliberately unnumbered — it's a proof interstitial like the logo
// strip, not another step in the argument.
---

<section id="case-video" class="px-6 md:px-12 pt-4 pb-24 md:pb-32">
  <div class="mx-auto max-w-[1200px]">
    <div
      class="bento-card relative border"
      style="border-color: rgba(249, 247, 241, 0.10); background: rgba(249, 247, 241, 0.03); color: var(--clik-cream); padding: clamp(16px, 2vw, 20px);"
    >
      <video
        controls
        preload="none"
        playsinline
        poster="/images/testimonials/bobby-mae-poster.jpg"
        class="w-full aspect-video rounded-xl bg-clik-midnight"
      >
        <source src="/videos/testimonial-bobby-mae.mp4" type="video/mp4" />
      </video>

      <div class="mt-5 flex items-center gap-3 px-2 pb-1">
        <span class="inline-flex h-7 items-center rounded-md border border-clik-cream/15 bg-clik-cream/10 px-2.5 shrink-0">
          <img src="/images/testimonials/mae-media.png" alt="MAE Media" class="h-3 w-auto" loading="lazy" />
        </span>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/70">
          <span class="font-bold text-clik-cream">Bobby</span>
          <span class="text-clik-cream/45"> · Founder, MAE Media</span>
        </p>
      </div>
    </div>
  </div>
</section>
