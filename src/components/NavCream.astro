---
// The bar is page furniture, not a widget parked on top of the page. It starts
// transparent and on the same 1200 grid as every section headline, then earns a
// tinted, blurred surface and a hairline once content passes under it.
//
// The CTA is deliberately quiet until the hero's own CTA leaves the screen —
// two identical royce buttons in one viewport just split the click.
// Solutions dropdown segments by audience: creators / agencies / media teams.
// Founding Creators lives in the footer, not the primary nav.
interface Props {
  theme?: 'cream' | 'midnight';
}
const { theme = 'cream' } = Astro.props;
const light = theme === 'midnight'; // dark page, so the bar carries cream type

// No pill. The bar sits on the page transparent and only earns a surface once
// content starts passing under it, which is the moment it needs one.
const t = light
  ? {
      shell: 'nav-dark',
      logo: '/logo-white.svg',
      link: 'text-clik-cream/85 hover:text-clik-cream',
      subtle: 'text-clik-cream/60 hover:text-clik-cream',
      panel: 'border-clik-cream/10',
      panelStyle: 'background: rgba(14, 24, 52, 0.97); backdrop-filter: blur(14px);',
      panelLink: 'text-clik-cream/80 hover:bg-clik-cream/5 hover:text-clik-cream',
      burger: '#F9F7F1',
    }
  : {
      shell: 'nav-light',
      logo: '/logo-black.svg',
      link: 'text-clik-midnight/80 hover:text-clik-midnight',
      subtle: 'text-clik-midnight/55 hover:text-clik-midnight',
      panel: 'border-clik-midnight/10',
      panelStyle: 'background: rgba(249, 247, 241, 0.97); backdrop-filter: blur(14px);',
      panelLink: 'text-clik-midnight/75 hover:bg-clik-midnight/5 hover:text-clik-midnight',
      burger: '#0E1834',
    };

// Pricing is audience-contextual: on the agencies page, "Pricing" jumps to the
// agency plans section. Everywhere else it goes to the home pricing tier grid.
const onAgenciesPage = Astro.url.pathname.startsWith('/use-cases/agencies');
const pricingHref = onAgenciesPage ? '#agency-plans' : '/#pricing';

const solutions = [
  { label: 'For Creators', href: '/use-cases/creators', track: 'CreatorNavClick', trackParams: { audience: 'creator', surface: 'nav' } },
  { label: 'For Agencies', href: '/use-cases/agencies', track: 'AgencyNavClick', trackParams: { audience: 'agency', surface: 'nav' } },
  { label: 'For Media Teams', href: '/use-cases/media-teams', track: 'MediaNavClick', trackParams: { audience: 'media', surface: 'nav' }, isNew: true },
];

const navLinks = [
  {
    label: 'Pricing',
    href: pricingHref,
    // Clicking Pricing while on the agencies page is a very high intent signal.
    track: onAgenciesPage ? 'AgencyPricingNavClick' : undefined,
    trackParams: onAgenciesPage ? { audience: 'agency', surface: 'nav' } : undefined,
  },
  { label: 'Blog', href: '/blog' },
  { label: 'Learn', href: '/docs' },
];
---

<nav data-nav class={`nav-shell ${t.shell} fixed inset-x-0 top-0 z-50 px-6 md:px-12`}>
  <span class="nav-rule" aria-hidden="true"></span>
  <div class="mx-auto flex h-[64px] max-w-[1200px] items-center justify-between md:h-[72px]">

    <a href="/" class="flex items-center">
      <img src={t.logo} alt="Clik" class="h-5 w-auto md:h-6" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">

      <!-- Solutions dropdown -->
      <div class="group relative">
        <button class={`flex items-center gap-1 font-ui text-sm font-bold transition-colors ${t.link}`}>
          Solutions
          <svg class="h-3 w-3 opacity-50 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none">
            <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:pointer-events-auto group-hover:opacity-100">
          <div class={`min-w-[210px] rounded-xl border p-1.5 ${t.panel}`} style={t.panelStyle}>
            {solutions.map((item) => (
              <a
                href={item.href}
                data-track-click={item.track}
                data-track-params={JSON.stringify(item.trackParams)}
                class={`flex items-center gap-2.5 rounded-lg px-3 py-2.5 font-ui text-sm font-bold transition-colors ${t.panelLink}`}
              >
                {item.label}
                {item.isNew && (
                  <span class="rounded-pill bg-clik-royce/25 px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-[0.14em] text-clik-royce">
                    New
                  </span>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          data-track-click={link.track}
          data-track-params={link.trackParams ? JSON.stringify(link.trackParams) : undefined}
          class={`font-ui text-sm font-bold transition-colors ${t.link}`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://app.clik.vision"
        class={`hidden font-ui text-sm font-bold transition-colors md:inline-block ${t.subtle}`}
      >
        Sign in
      </a>
      <a
        href="https://app.clik.vision/sign-up"
        class="nav-cta hidden items-center gap-1.5 rounded-lg px-4 py-2 font-ui text-sm font-bold md:inline-flex"
      >
        Start for free <span aria-hidden="true">→</span>
      </a>
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-lg md:hidden"
        aria-label="Open menu"
      >
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none">
          <path d="M0 1h20M0 7h20M0 13h20" stroke={t.burger} stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu — bottom-sheet drawer on cream surface, brand language -->
<div
  id="mobile-menu-backdrop"
  class="pointer-events-none fixed inset-0 z-[55] bg-black/55 opacity-0 transition-opacity duration-200 ease-out md:hidden"
  aria-hidden="true"
></div>

<div
  id="mobile-menu-drawer"
  class="mobile-menu-drawer fixed inset-x-0 bottom-0 z-[60] flex max-h-[75vh] translate-y-full flex-col rounded-t-[20px] transition-transform duration-[280ms] ease-out md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
>
  <!-- Drag handle pill -->
  <div class="flex shrink-0 justify-center pt-3 pb-2">
    <span class="block h-1 w-9 rounded-full bg-clik-midnight/20" aria-hidden="true"></span>
  </div>

  <!-- Close button -->
  <button
    id="mobile-menu-close"
    class="absolute right-3 top-3 flex h-10 w-10 items-center justify-center text-clik-midnight/65 transition-colors hover:text-clik-midnight"
    aria-label="Close menu"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>

  <!-- Scrollable nav content -->
  <nav class="flex-1 overflow-y-auto px-6 pb-6 pt-3">
    {solutions.map((item, i) => (
      <a
        href={item.href}
        data-track-click={item.track}
        data-track-params={JSON.stringify({ ...item.trackParams, surface: 'mobile-drawer' })}
        class="mobile-menu-link mobile-menu-row stagger-row"
        style={`--i: ${i}`}
      >
        <span class="flex items-center gap-2">
          {item.label}
          {item.isNew && (
            <span class="rounded-pill border border-clik-royce/40 bg-clik-royce/10 px-1.5 py-[1px] text-[9px] font-bold uppercase tracking-[0.14em] text-clik-royce">NEW</span>
          )}
        </span>
        <svg class="mobile-menu-chevron" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
    ))}
    <a
      href={pricingHref}
      data-track-click={onAgenciesPage ? 'AgencyPricingNavClick' : undefined}
      data-track-params={onAgenciesPage ? JSON.stringify({ audience: 'agency', surface: 'mobile-drawer' }) : undefined}
      class="mobile-menu-link mobile-menu-row stagger-row"
      style="--i: 3"
    >
      <span>Pricing</span>
      <svg class="mobile-menu-chevron" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </a>
    <a href="/blog" class="mobile-menu-link mobile-menu-row stagger-row" style="--i: 4">
      <span>Blog</span>
      <svg class="mobile-menu-chevron" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </a>
    <a href="/docs" class="mobile-menu-link mobile-menu-row stagger-row" style="--i: 5">
      <span>Learn</span>
      <svg class="mobile-menu-chevron" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </a>
  </nav>

  <!-- Pinned bottom CTA -->
  <div class="shrink-0 border-t border-clik-midnight/10 px-6 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
    <div class="flex items-center gap-4">
      <a href="https://app.clik.vision" class="mobile-menu-link font-ui text-sm font-bold text-clik-midnight/65 transition-colors hover:text-clik-midnight">
        Sign in
      </a>
      <a href="https://app.clik.vision/sign-up" class="mobile-menu-link clik-btn clik-btn-primary ml-auto">
        Start for free <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .mobile-menu-drawer {
    background: #FAFAF7;
    color: var(--clik-midnight);
    box-shadow: 0 -1px 0 rgba(14, 24, 52, 0.08); /* hairline above the top edge, subtle */
  }

  /* Nav rows — destination label in display/serif treatment */
  .mobile-menu-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 56px;
    padding: 10px 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--clik-midnight);
    background: transparent;
    border: none;
    cursor: pointer;
    border-bottom: 0.5px solid rgba(14, 24, 52, 0.12); /* hairline divider */
  }
  /* No divider on the final row in the nav */
  nav > .mobile-menu-row:last-child {
    border-bottom: none;
  }
  .mobile-menu-row:active {
    background: rgba(14, 24, 52, 0.03);
  }

  .mobile-menu-chevron {
    width: 14px;
    height: 14px;
    opacity: 0.45;
    color: currentColor;
  }

  /* Stagger-fade animation on open — rows fade in 40ms apart, 200ms each */
  .mobile-menu-drawer .stagger-row {
    opacity: 0;
    transform: translateY(8px);
  }
  .mobile-menu-drawer.drawer-open .stagger-row {
    animation: mobileNavStagger 200ms ease-out forwards;
    animation-delay: calc(var(--i, 0) * 40ms);
  }
  @keyframes mobileNavStagger {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const close = document.getElementById('mobile-menu-close');
  const links = drawer?.querySelectorAll('.mobile-menu-link');

  function openMenu() {
    drawer?.classList.remove('translate-y-full');
    drawer?.classList.add('drawer-open');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    drawer?.classList.add('translate-y-full');
    drawer?.classList.remove('drawer-open');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  links?.forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('drawer-open')) {
      closeMenu();
    }
  });
</script>

<style>
  .nav-shell {
    position: fixed;
    transition: background-color 0.32s ease, backdrop-filter 0.32s ease;
  }
  .nav-shell .nav-rule {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--nav-rule);
    opacity: 0;
    transition: opacity 0.32s ease;
  }
  .nav-shell.is-stuck .nav-rule { opacity: 1; }

  .nav-dark {
    --nav-rule: rgba(249, 247, 241, 0.1);
    --cta-border: rgba(249, 247, 241, 0.28);
    --cta-fg: #F9F7F1;
  }
  .nav-dark.is-stuck {
    background: rgba(11, 19, 44, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .nav-light {
    --nav-rule: rgba(14, 24, 52, 0.1);
    --cta-border: rgba(14, 24, 52, 0.25);
    --cta-fg: #0E1834;
  }
  .nav-light.is-stuck {
    background: rgba(249, 247, 241, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .nav-cta {
    border: 1px solid var(--cta-border);
    color: var(--cta-fg);
    background: transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }
  .nav-cta:hover { border-color: var(--cta-fg); }

  /* Once the hero's CTA is gone, this is the only one left, so it fills in. */
  .nav-shell.is-live .nav-cta {
    background: #5481E8;
    border-color: #5481E8;
    color: #F9F7F1;
  }
  .nav-shell.is-live .nav-cta:hover { background: #6b93ec; border-color: #6b93ec; }

  @media (prefers-reduced-motion: reduce) {
    .nav-shell, .nav-shell .nav-rule, .nav-cta { transition: none; }
  }
</style>

<script>
  const navShell = document.querySelector<HTMLElement>('[data-nav]');
  if (navShell) {
    const hero = document.querySelector<HTMLElement>('[data-section="hero"]');
    let ticking = false;
    const sync = () => {
      navShell.classList.toggle('is-stuck', window.scrollY > 16);
      // Off the homepage there is no hero CTA to defer to, so the bar owns it.
      const live = hero ? hero.getBoundingClientRect().bottom < 140 : true;
      navShell.classList.toggle('is-live', live);
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };
    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
