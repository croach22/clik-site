---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout
  title="Blog — Clik"
  description="Tips, guides, and stories for short-form video creators. From editing tricks to AI workflows."
  theme="cream"
>
  <main class="mx-auto max-w-[1200px] px-6 md:px-12 pt-32 pb-24">

    <!-- Header -->
    <div class="mb-14">
      <div class="clik-section-header">
        <span class="idx">[ ]</span>
        <span class="rule"></span>
        <span class="label">FROM THE TEAM</span>
      </div>
      <h1 class="font-display font-medium text-clik-midnight mb-4" style="font-size: clamp(40px, 6vw, 64px); line-height: 1.05; letter-spacing: -0.02em;">
        Blog<span class="clik-period">.</span>
      </h1>
      <p class="font-ui text-clik-midnight/70 max-w-xl" style="font-size: 18px; line-height: 1.55;">
        Tips, guides, and stories for creators who want to spend less time editing and more time filming.
      </p>
    </div>

    <!-- Article grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group flex flex-col rounded-xl border border-clik-midnight/10 bg-clik-cream overflow-hidden hover:border-clik-midnight/25 transition-colors duration-200"
        >
          <!-- Cover image -->
          <div class="aspect-video overflow-hidden bg-clik-bone">
            <img
              src={post.data.coverImage}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='/images/articles/placeholder.svg'"
            />
          </div>

          <!-- Card body -->
          <div class="flex flex-col flex-1 p-5 gap-3">
            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="font-mono text-[10px] uppercase tracking-[0.14em] px-2 py-0.5 rounded-pill border border-clik-midnight/15 text-clik-midnight/55">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Title -->
            <h2 class="font-display font-medium text-clik-midnight leading-snug line-clamp-2" style="font-size: 18px; letter-spacing: -0.01em;">
              {post.data.title}
            </h2>

            <!-- Description -->
            <p class="font-ui text-sm text-clik-midnight/55 leading-relaxed line-clamp-2 flex-1">
              {post.data.description}
            </p>

            <!-- Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-clik-midnight/10">
              <time class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/45" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-royce group-hover:translate-x-0.5 transition-transform">
                READ →
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </main>
</BaseLayout>
