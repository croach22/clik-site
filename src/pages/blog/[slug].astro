---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTACream from '../../components/CTACream.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout title={`${entry.data.title} — Clik`} description={entry.data.description} theme="cream">

  <article class="mx-auto max-w-3xl px-6 pt-32 pb-16">

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-5">
      {entry.data.tags.map((tag) => (
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] px-2.5 py-1 rounded-pill border border-clik-midnight/15 text-clik-midnight/55">
          {tag}
        </span>
      ))}
    </div>

    <!-- Title -->
    <h1 class="font-display font-medium text-clik-midnight leading-tight mb-4" style="font-size: clamp(32px, 5vw, 48px); letter-spacing: -0.02em;">
      {entry.data.title}
    </h1>

    <!-- Description + date -->
    <p class="font-ui text-lg text-clik-midnight/70 leading-relaxed mb-3">{entry.data.description}</p>
    <time class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-midnight/45 block mb-10" datetime={entry.data.date.toISOString()}>
      {formatDate(entry.data.date)}
    </time>

    <!-- Cover image -->
    <div class="rounded-xl overflow-hidden mb-12 aspect-video bg-clik-bone">
      <img
        src={entry.data.coverImage}
        alt={entry.data.title}
        class="w-full h-full object-cover"
        onerror="this.src='/images/articles/placeholder.svg'"
      />
    </div>

    <!-- Body -->
    <div class="prose prose-cream max-w-none">
      <Content />
    </div>

    <!-- Back link -->
    <div class="mt-16 pt-8 border-t border-clik-midnight/12">
      <a href="/blog" class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce hover:opacity-80 transition-opacity">
        ← BACK TO BLOG
      </a>
    </div>

  </article>

  <CTACream />

</BaseLayout>

<style is:global>
  /* Cream-theme prose */
  .prose-cream {
    --tw-prose-body:           rgba(14, 24, 52, 0.8);
    --tw-prose-headings:       #0E1834;
    --tw-prose-lead:           rgba(14, 24, 52, 0.7);
    --tw-prose-links:          #5481E8;
    --tw-prose-bold:           #0E1834;
    --tw-prose-counters:       rgba(14, 24, 52, 0.5);
    --tw-prose-bullets:        rgba(14, 24, 52, 0.35);
    --tw-prose-hr:             rgba(14, 24, 52, 0.10);
    --tw-prose-quotes:         #0E1834;
    --tw-prose-quote-borders:  #5481E8;
    --tw-prose-captions:       rgba(14, 24, 52, 0.45);
    --tw-prose-code:           #F9838E;
    --tw-prose-pre-code:       #F9F7F1;
    --tw-prose-pre-bg:         #0E1834;
    --tw-prose-th-borders:     rgba(14, 24, 52, 0.12);
    --tw-prose-td-borders:     rgba(14, 24, 52, 0.08);
  }
  .prose-cream {
    font-family: var(--font-ui);
  }
  .prose-cream h1, .prose-cream h2, .prose-cream h3, .prose-cream h4 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .prose-cream h2 { margin-top: 2.5rem; }
  .prose-cream h3 { margin-top: 2rem; }
  .prose-cream a {
    text-decoration: none;
    border-bottom: 1px solid rgba(84, 129, 232, 0.4);
    transition: border-color 0.2s;
  }
  .prose-cream a:hover { border-color: #5481E8; }
  .prose-cream table { font-size: 0.875rem; }
  .prose-cream th { background: rgba(14, 24, 52, 0.04); }
  .prose-cream img { border-radius: 0.75rem; }
  .prose-cream .placeholder-img { opacity: 0.5; }
  .prose-cream blockquote {
    border-left-color: #5481E8;
    background: rgba(84, 129, 232, 0.05);
    padding: 1rem 1.25rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
</style>
