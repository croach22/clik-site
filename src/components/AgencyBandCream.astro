---
// Slim agency callout band — sits between Hero and Value.
// One line: eyebrow tag · headline · arrow CTA → /use-cases/agencies
---

<section class="border-y border-clik-midnight/10 bg-clik-bone/40">
  <a
    href="/use-cases/agencies"
    data-track-click="AgencyBandClick"
    data-track-params={JSON.stringify({ audience: 'agency', surface: 'agency-band' })}
    data-track-view="AgencyBandView"
    class="group block px-6 md:px-12 py-5 md:py-6 no-underline"
  >
    <div class="mx-auto max-w-[1200px] flex flex-col items-start gap-3 md:flex-row md:items-center md:gap-6">
      <span class="clik-chip clik-chip-fill-royce shrink-0" style="font-size: 9px;">
        <span class="dot" style="background: var(--clik-cream);"></span>
        FOR AGENCIES
      </span>

      <p
        class="flex-1 font-display font-medium text-clik-midnight"
        style="font-size: clamp(18px, 2vw, 22px); line-height: 1.25; letter-spacing: -0.01em;"
      >
        Scale output, not headcount<span class="clik-period">.</span>
        <span class="font-ui font-normal text-clik-midnight/65" style="font-size: clamp(15px, 1.6vw, 17px);">
          Feed Clik a shoot day and a brief — your editors finish 90%-done drafts.
        </span>
      </p>

      <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce transition-opacity group-hover:opacity-80 shrink-0">
        See how <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</section>
