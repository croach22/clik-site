---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCream from '../components/HeroCream.astro';
import LogoStripCream from '../components/LogoStripCream.astro';
import SocialProofCream from '../components/SocialProofCream.astro';
import FeaturesBento from '../components/FeaturesBento';
import CaseVideoCream from '../components/CaseVideoCream.astro';
import ComparisonCream from '../components/ComparisonCream.astro';
import AutopilotCream from '../components/AutopilotCream.astro';
import PricingCream from '../components/PricingCream.astro';
import NotForCream from '../components/NotForCream.astro';
import FaqCream from '../components/FaqCream.astro';
import CTACream from '../components/CTACream.astro';
---

<BaseLayout
  title="Clik - On-Brand Content Workflows For Any Video Input"
  description="Point Clik at a shoot, a podcast, or a folder of clips. It finds the videos, builds them on brand, and gets sharper every project."
  theme="midnight"
>
  <div data-section="hero"><HeroCream /></div>
  <div data-section="logo-strip"><LogoStripCream /></div>
  <div data-section="social-proof"><SocialProofCream /></div>
  <div data-section="features"><FeaturesBento client:visible /></div>
  <div data-section="case-video"><CaseVideoCream /></div>
  <div data-section="comparison"><ComparisonCream /></div>
  <div data-section="autopilot"><AutopilotCream /></div>
  <div data-section="pricing"><PricingCream /></div>
  <div data-section="who-for"><NotForCream /></div>
  <div data-section="faq"><FaqCream /></div>
  <div data-section="cta"><CTACream /></div>
</BaseLayout>
