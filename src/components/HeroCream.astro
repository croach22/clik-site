---
// Hero — engine/throughput ethos, no camera motifs. Kicker gets the
// accent-bar treatment; the headline sits clean above the loop.
// Headline stays input-agnostic (shoots, podcasts, clip folders) so clipping
// isn't alienated; the subhead does the differentiating — "sorts, plans" is
// the wedge nobody else can claim.
// Visual: HeroLoop — code-built inputs → hub → fan-out loop.
import HeroLoop from './HeroLoop';
const CALENDLY_URL = 'https://calendly.com/clikphotos/clik-agency-demo';
---

<section id="hero" class="relative pt-32 md:pt-36">
  <div class="relative mx-auto max-w-[1200px] px-6 md:px-12 pb-24">

    <div class="w-full py-8 md:py-12">
      <!-- Kicker — vertical accent bar, systems language -->
      <div class="flex items-center gap-3">
        <span class="h-4 w-[3px] rounded-full bg-clik-royce" aria-hidden="true"></span>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
          AI-Powered Content Ops
        </p>
      </div>

      <!-- Headline -->
      <h1
        class="mt-6 font-display font-medium tracking-display text-clik-cream"
        style="font-size: clamp(44px, 8vw, 72px); line-height: 1.02; letter-spacing: -0.02em; max-width: 20ch;"
      >
        An on-brand content engine for any video input<span class="clik-period">.</span>
      </h1>

      <!-- Body -->
      <p class="mt-6 max-w-[620px] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.55;">
        Point it at a shoot, a podcast, or a folder of clips. It sorts, plans, and builds — and gets sharper every project.
      </p>

      <!-- CTAs — self-serve + teams who want a conversation first -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="https://app.clik.vision/sign-up" class="clik-btn clik-btn-primary">
          Start for free <span aria-hidden="true">→</span>
        </a>
        <a href={CALENDLY_URL} class="clik-btn clik-btn-secondary">
          Book a demo
        </a>
      </div>
    </div>

    <!-- Hero visual — looping inputs → engine → fan-out animation, with
         flowing line-art garnish converging into the card from both sides -->
    <div class="relative mt-12 md:mt-16">
      <svg
        class="pointer-events-none absolute -left-24 top-1/2 hidden w-64 -translate-y-1/2 md:block"
        viewBox="0 0 260 200"
        fill="none"
        aria-hidden="true"
      >
        {[0, 1, 2, 3, 4].map((i) => (
          <path
            d={`M0 ${30 + i * 35} C 120 ${30 + i * 35}, 160 ${100 - i * 4}, 260 ${96 + i * 2}`}
            stroke="#5481E8"
            stroke-opacity={0.28 - i * 0.04}
            stroke-width="1.2"
          />
        ))}
      </svg>
      <svg
        class="pointer-events-none absolute -right-24 top-1/2 hidden w-64 -translate-y-1/2 md:block"
        viewBox="0 0 260 200"
        fill="none"
        aria-hidden="true"
      >
        {[0, 1, 2, 3, 4].map((i) => (
          <path
            d={`M260 ${30 + i * 35} C 140 ${30 + i * 35}, 100 ${100 - i * 4}, 0 ${96 + i * 2}`}
            stroke="#F9838E"
            stroke-opacity={0.22 - i * 0.035}
            stroke-width="1.2"
          />
        ))}
      </svg>
      <HeroLoop client:load />
    </div>
  </div>
</section>
