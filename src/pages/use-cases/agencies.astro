---
// For Agencies — the content engine under your agency.
// Engine positioning: volume/efficiency/scale. Dark bento system.
// Agency plans data + #agency-plans anchor + tracking preserved.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgencyPilotForm from '../../components/AgencyPilotForm';

const CARD = 'border-color: rgba(249, 247, 241, 0.10); background: rgba(249, 247, 241, 0.03);';

const capabilities = [
  {
    title: 'Open at the 90% mark',
    body: 'Every video in your script arrives as a near-finished rough cut. AI Search surfaces any clip your editor wants to swap. Their job is craft, not assembly.',
    accent: '#5481E8',
  },
  {
    title: 'The agent tells you what’s missing',
    body: 'Clik reads your brief and notices the gaps: a shot you didn’t get, a graphic that doesn’t exist yet, a hook with no matching B-roll. Your CD can reshoot, pivot, or rewrite while there’s still time.',
    accent: '#F9838E',
  },
  {
    title: 'Plugs into your stack',
    body: 'Export to XML for Premiere Pro, DaVinci Resolve, or Final Cut Pro when it’s time to finish. Drive, Dropbox, and Box triggers coming soon. Clik fits how your editors already work.',
    accent: '#9785B8',
  },
];

const steps = [
  {
    title: 'Upload a shoot day + brief.',
    body: 'Raw client footage, scripts, hook variants, creative direction, all into one workflow.',
  },
  {
    title: 'Clik plans the output.',
    body: 'A list of video variants with titles, scope, and duration. Your creative director reviews, tweaks, approves.',
  },
  {
    title: 'The build agent executes in parallel.',
    body: 'One project per variant. Each ~90% done when your editor opens it.',
  },
  {
    title: 'Editors finish in Clik.',
    body: "Add caption text overlays right in Clik's web editor. Your whole team collaborates online, with no project files to pass around. Export to Premiere Pro, DaVinci Resolve, or Final Cut Pro when you need deeper timeline control.",
  },
];

const planIncludes = [
  'Shared Slack with the Clik team',
  'Hands-on prompt and workflow help',
  'Feature prioritization based on your needs',
  'Monthly workflow review',
];

const CALENDLY = 'https://calendly.com/clikphotos/clik-agency-demo';
---

<BaseLayout
  title="Clik for Agencies · Scale your agency without hiring more editors"
  description="Feed Clik a shoot day and a brief. It plans and builds every deliverable, so your editors finish the work instead of starting from scratch."
  theme="midnight"
>

  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 md:pt-36">
    <div class="dot-grid absolute inset-x-0 top-0 h-[520px]" aria-hidden="true"></div>
    <div
      class="glow -top-24 left-[-10%] h-[420px] w-[640px]"
      style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.14), transparent 72%);"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-[1296px] px-6 md:px-12 pb-16">
      <div class="w-full py-8 md:py-10">
        <div class="grid gap-12 md:grid-cols-[1fr_360px] md:gap-16 items-start">
          <!-- Left column: kicker + headline + sub -->
          <div>
            <div class="flex items-center gap-3">
              <span class="h-4 w-[3px] rounded-full bg-clik-royce" aria-hidden="true"></span>
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">For Agencies</p>
            </div>

            <h1
              class="mt-6 font-display font-medium tracking-display text-clik-cream"
              style="font-size: clamp(40px, 6vw, 60px); line-height: 1.05; letter-spacing: -0.02em;"
            >
              3× your client capacity with the editors you already have<span class="clik-period">.</span>
            </h1>

            <p class="mt-6 max-w-[560px] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.55;">
              Clik is the content engine under your agency. Every client runs on one system: planned, built, on brand. Your editors finish craft instead of assembly.
            </p>
          </div>

          <!-- Right column: pilot lead form -->
          <div class="w-full md:max-w-[360px]">
            <AgencyPilotForm client:load />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- [01] Problem -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 01 ]</span>
        <span class="rule"></span>
        <span class="label">THE PROBLEM</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-8" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        Editing is your revenue cap, not demand<span class="clik-period">.</span>
      </h2>
      <p class="font-ui text-clik-cream/70 mb-8" style="font-size: 18px; line-height: 1.6;">
        The work keeps coming in. Your editors can't keep up. The usual options:
      </p>
      <ul class="space-y-5 mb-8">
        <li class="flex gap-4">
          <span class="mt-3 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-clik-salmon"></span>
          <p class="font-ui text-clik-cream/80" style="font-size: 18px; line-height: 1.6;">
            <span class="font-semibold text-clik-cream">Hire more in-house editors.</span> $5k–$10k/mo each, plus ramp time, recruiting, and management overhead.
          </p>
        </li>
        <li class="flex gap-4">
          <span class="mt-3 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-clik-salmon"></span>
          <p class="font-ui text-clik-cream/80" style="font-size: 18px; line-height: 1.6;">
            <span class="font-semibold text-clik-cream">Offshore it.</span> Cheaper, but quality varies and async revisions drag every project across days.
          </p>
        </li>
        <li class="flex gap-4">
          <span class="mt-3 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-clik-salmon"></span>
          <p class="font-ui text-clik-cream/80" style="font-size: 18px; line-height: 1.6;">
            <span class="font-semibold text-clik-cream">Turn down clients.</span> Safe in the short term. Kills growth.
          </p>
        </li>
      </ul>
      <p class="max-w-[92ch] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.6;">
        Meanwhile, your creative directors live in review loops instead of actually directing creative.
      </p>
    </div>
  </section>

  <!-- [02] What Clik delivers, day one -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 02 ]</span>
        <span class="rule"></span>
        <span class="label">BEFORE EDITORS START</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <!-- Headline left, intro right — uses the full width at a readable measure -->
      <div class="mb-12 grid gap-x-12 gap-y-5 md:grid-cols-2 md:items-end">
        <h2 class="font-display font-medium text-clik-cream" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        What Clik delivers, day one<span class="clik-period">.</span>
        </h2>
        <p class="max-w-[92ch] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.6;">
        Upload a shoot and a brief. Before your editor opens the project, Clik has already done two things.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- LEFT: Brief audit report -->
        <div class="bento-card border flex flex-col" style={`${CARD} padding: 32px;`}>
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
            01 · Brief Audit
          </p>
          <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(22px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em;">
            An audit of your shoot, against your brief.
          </h3>
          <p class="font-ui text-clik-cream/70 mb-6" style="font-size: 16px; line-height: 1.55;">
            Clik reads the brief, scans the footage, and tells you what's there, and what isn't.
          </p>

          <div class="mt-auto rounded-xl border border-clik-cream/10 bg-clik-cream/[0.04] p-5">
            <div class="flex items-center justify-between border-b border-clik-cream/10 pb-3 mb-4">
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/55">
                Spring Cleanser · UGC Brief
              </span>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-royce font-bold">
                12 / 14 captured
              </span>
            </div>
            <ul class="space-y-2.5 font-ui text-clik-cream/85" style="font-size: 14px; line-height: 1.5;">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/20 font-mono text-[10px] font-bold text-clik-royce">✓</span>
                Hook to-camera: "POV: my skin finally calmed down"
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/20 font-mono text-[10px] font-bold text-clik-royce">✓</span>
                Product application, face-cam, AM routine
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-salmon/25 font-mono text-[10px] font-bold text-clik-salmon">✗</span>
                Missing: direct-to-camera testimonial, "why this one"
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-salmon/25 font-mono text-[10px] font-bold text-clik-salmon">✗</span>
                Missing: golden hour B-roll, product on bathroom counter
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/10 font-mono text-[10px] font-bold text-clik-royce">+</span>
                Off-script: "this honestly smells like a spa" at 02:14
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/10 font-mono text-[10px] font-bold text-clik-royce">+</span>
                Alt hook take: hand-brush hair back reads stronger
              </li>
            </ul>
          </div>
        </div>

        <!-- RIGHT: First drafts speed comparison -->
        <div class="bento-card border flex flex-col" style={`${CARD} padding: 32px;`}>
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
            02 · First Drafts
          </p>
          <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(22px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em;">
            Drafts in 12 minutes, not 3 days.
          </h3>
          <p class="font-ui text-clik-cream/70 mb-8" style="font-size: 16px; line-height: 1.55;">
            Every variant in your script lands as a ~90%-done rough cut. Your editors finish it. They don't start from scratch.
          </p>

          <div class="mt-auto space-y-3">
            <div class="rounded-xl border p-6" style="border-color: rgba(84, 129, 232, 0.4); background: rgba(84, 129, 232, 0.10);">
              <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-royce mb-2 font-bold">
                With Clik
              </p>
              <p class="font-display font-medium text-clik-cream" style="font-size: clamp(44px, 6vw, 64px); line-height: 1; letter-spacing: -0.03em;">
                12 min
              </p>
              <p class="mt-2 font-ui text-clik-cream/70" style="font-size: 14px; line-height: 1.5;">
                Brief in. Per-variant drafts ready for editors.
              </p>
            </div>

            <div class="rounded-xl border border-clik-cream/10 bg-clik-cream/[0.04] p-5">
              <div class="flex items-baseline justify-between">
                <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55 font-bold">
                  Editor from scratch
                </p>
                <p class="font-display font-medium text-clik-cream/55" style="font-size: 28px; line-height: 1; letter-spacing: -0.02em;">
                  ~3 days
                </p>
              </div>
              <p class="mt-2 font-ui text-clik-cream/55" style="font-size: 13px; line-height: 1.5;">
                Typical agency assembly + first-pass turnaround, per variant.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- [03] How agencies run Clik -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 03 ]</span>
        <span class="rule"></span>
        <span class="label">HOW IT WORKS</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-12" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        How agencies run Clik<span class="clik-period">.</span>
      </h2>

      <ol class="space-y-5">
        {steps.map((step, i) => (
          <li class="bento-card border flex gap-5" style={`${CARD} padding: 28px;`}>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border font-mono text-sm font-bold text-clik-royce" style="border-color: rgba(84, 129, 232, 0.4); background: rgba(84, 129, 232, 0.12);">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <p class="mb-2 font-display font-medium text-clik-cream" style="font-size: 20px; line-height: 1.2; letter-spacing: -0.01em;">{step.title}</p>
              <p class="font-ui text-clik-cream/70" style="font-size: 16px; line-height: 1.55;">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-10 font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.6;">
        Same team. Multiples more output.
      </p>
    </div>
  </section>

  <!-- [04] Capabilities -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 04 ]</span>
        <span class="rule"></span>
        <span class="label">CAPABILITIES</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-12" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        The unfair advantages<span class="clik-period">.</span>
      </h2>

      <div class="grid gap-5 md:grid-cols-3">
        {capabilities.map((cap) => (
          <div class="bento-card border" style={`${CARD} padding: 28px;`}>
            <span
              class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-lg text-sm"
              style={`color: ${cap.accent}; background: ${cap.accent}14; border: 1px solid ${cap.accent}35;`}
              aria-hidden="true"
            >✦</span>
            <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(20px, 2.2vw, 24px); line-height: 1.2; letter-spacing: -0.01em;">
              {cap.title}<span class="clik-period">.</span>
            </h3>
            <p class="font-ui text-clik-cream/70" style="font-size: 16px; line-height: 1.6;">
              {cap.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- [05] Proof -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 05 ]</span>
        <span class="rule"></span>
        <span class="label">PROOF</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <div class="bento-card border mb-8 p-3" style={CARD}>
        <video
          controls
          preload="metadata"
          playsinline
          poster="/images/testimonials/bobby-mae-poster.jpg"
          class="w-full aspect-video rounded-xl bg-black"
        >
          <source src="/videos/testimonial-bobby-mae.mp4" type="video/mp4" />
        </video>
        <div class="flex items-center gap-3 px-4 pt-5 pb-3">
          <span class="inline-flex h-7 items-center rounded-md border border-clik-cream/15 bg-clik-cream/10 px-2.5 shrink-0">
            <img src="/images/testimonials/mae-media.png" alt="MAE Media" class="h-3 w-auto" loading="lazy" />
          </span>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/70">
            <span class="font-bold text-clik-cream">Bobby</span>
            <span class="text-clik-cream/45"> · Founder, MAE Media</span>
          </p>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <div class="bento-card border flex flex-col" style={`${CARD} padding: 28px;`}>
          <p class="font-ui text-clik-cream/85 leading-relaxed mb-4" style="font-size: 16px;">
            "Clik is by far the fastest path from raw footage to finished content I've ever used. We'll upload an entire shoot's worth of footage and get back tons of serviceable edits almost instantly. It even suggests really good angles and edits our team hadn't considered prior."
          </p>
          <p class="font-ui text-clik-cream/85 leading-relaxed" style="font-size: 16px;">
            "I love that it knows everything we shot — from visuals to dialog to b-roll — so it never misses the right moment, and the pacing of the cuts feels like it came from a veteran editor. It's really freaking good!"
          </p>
          <div class="mt-auto pt-6 flex items-center gap-3">
            <span class="inline-flex h-7 items-center rounded-md border border-clik-cream/15 bg-clik-cream/10 px-2.5 shrink-0">
              <img src="/images/testimonials/feed-studios.png" alt="Feed Studios" class="h-3 w-auto" loading="lazy" />
            </span>
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/70">
              <span class="font-bold text-clik-cream">Andrew Basille</span>
              <span class="text-clik-cream/45"> · Feed Studios</span>
            </p>
          </div>
        </div>

        <div class="bento-card border flex flex-col" style={`${CARD} padding: 28px;`}>
          <p class="font-ui text-clik-cream/85 leading-relaxed" style="font-size: 16px;">
            "Clik finds extra concepts in my footage that a traditional editor would never bother to pull. Same shoot, more deliverables, less time."
          </p>
          <div class="mt-auto pt-6 flex items-center gap-3">
            <span class="inline-flex h-7 items-center rounded-md border border-clik-cream/15 bg-clik-cream/10 px-2 shrink-0">
              <img src="/images/testimonials/mae-media.png" alt="MAE Media" class="h-3 w-auto" loading="lazy" />
            </span>
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/70">
              <span class="font-bold text-clik-cream">Bobby</span>
              <span class="text-clik-cream/45"> · Founder, MAE Media</span>
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border p-8" style="border-color: rgba(84, 129, 232, 0.4); background: rgba(84, 129, 232, 0.10);">
        <p class="font-display font-medium text-clik-cream" style="font-size: clamp(20px, 2.4vw, 24px); line-height: 1.3; letter-spacing: -0.01em;">
          Feed Studios LA estimates Clik cuts <span class="text-clik-royce font-semibold">~90% of the work</span> out of their editing flow.
        </p>
      </div>
    </div>
  </section>

  <!-- [06] Agency plans -->
  <section
    id="agency-plans"
    data-track-view="AgencyPlansView"
    data-track-params={JSON.stringify({ audience: 'agency', surface: 'agency-page' })}
    class="scroll-mt-24 px-6 md:px-12 py-16 md:py-20"
  >
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header justify-center">
        <span class="idx">[ 06 ]</span>
        <span class="rule"></span>
        <span class="label">AGENCY PLANS</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-4" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        Built for your volume<span class="clik-period">.</span>
      </h2>
      <p class="font-ui text-clik-cream/70 mb-12 max-w-2xl mx-auto" style="font-size: 18px; line-height: 1.6;">
        Transparent floor. Custom from there, scaled to your monthly output.
      </p>

      <div
        class="relative rounded-[17px] p-px text-left"
        style="background: linear-gradient(120deg, rgba(84, 129, 232, 0.55), rgba(84, 129, 232, 0.10) 30%, rgba(249, 131, 142, 0.10) 70%, rgba(249, 131, 142, 0.5));"
      >
      <div
        class="bento-card relative overflow-hidden"
        style="background: #101B3E; color: var(--clik-cream); padding: clamp(28px, 4vw, 40px);"
      >
        <div class="mb-8 pb-8 border-b border-clik-cream/12">
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce font-bold">
            Starting at
          </p>
          <div class="flex items-baseline gap-2">
            <span class="font-display font-medium text-clik-cream" style="font-size: clamp(48px, 7vw, 72px); line-height: 1; letter-spacing: -0.03em;">
              $499
            </span>
            <span class="font-mono text-[14px] uppercase tracking-[0.14em] text-clik-cream/55">
              / mo
            </span>
          </div>
          <p class="mt-3 font-ui text-clik-cream/70" style="font-size: 15px; line-height: 1.5;">
            Volume-based, scaling with your monthly video output. Cancel anytime.
          </p>
        </div>

        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
          Every plan includes:
        </p>
        <ul class="space-y-3 mb-8">
          {planIncludes.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-4 w-4 shrink-0 text-clik-royce" viewBox="0 0 16 16" fill="none">
                <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="font-ui text-clik-cream/85" style="font-size: 16px; line-height: 1.55;">{item}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <a
            href={CALENDLY}
            target="_blank"
            rel="noopener noreferrer"
