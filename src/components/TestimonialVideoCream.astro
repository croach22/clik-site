---
// Featured video testimonial — Bobby, MAE Media.
// Lives between ValueCream and QuoteCream as proof of the value claim.
---

<section class="px-6 md:px-12 py-20 md:py-28">
  <div class="mx-auto max-w-[1100px]">
    <div class="clik-section-header">
      <span class="idx">[ 02 ]</span>
      <span class="rule"></span>
      <span class="label">FROM A REAL AGENCY</span>
    </div>

    <div
      class="clik-frame relative bg-clik-cream"
      style="color: var(--clik-midnight); padding: clamp(16px, 2vw, 20px);"
    >
      <span class="clik-corner-tr"></span>
      <span class="clik-corner-bl"></span>

      <video
        controls
        preload="none"
        playsinline
        poster="/images/testimonials/bobby-mae-poster.jpg"
        class="w-full aspect-video rounded-xl bg-clik-midnight"
      >
        <source src="/videos/testimonial-bobby-mae.mp4" type="video/mp4" />
      </video>

      <div class="mt-5 flex items-center gap-3 px-2 pb-1">
        <span class="inline-flex h-7 items-center rounded-md bg-clik-midnight px-2.5 shrink-0">
          <img src="/images/testimonials/mae-media.png" alt="MAE Media" class="h-3 w-auto" loading="lazy" />
        </span>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-midnight/70">
          <span class="font-bold text-clik-midnight">Bobby</span>
          <span class="text-clik-midnight/45"> · Founder, MAE Media</span>
        </p>
      </div>
    </div>
  </div>
</section>
