---
// Thin trust bar immediately below the hero — no section header, no idx
// (same "quiet band" treatment as the old AgencyBandCream).
//
// Every logo sits on the same cream tile so the row reads as one system.
// `filter` normalizes whatever source art we were given:
//   • invert            → white-knockout art becomes dark
//   • grayscale invert  → light-on-black art becomes dark monochrome
//                         (straight invert would flip brand hues)
// mix-blend-multiply then drops any baked-in white background to transparent.
const logos = [
  { src: '/images/testimonials/keller-williams.png', alt: 'Keller Williams', h: 'h-7', filter: '' },
  { src: '/images/testimonials/dapper.png', alt: 'Dapper', h: 'h-5', filter: '' },
  { src: '/images/testimonials/oasis.png', alt: 'Oasis', h: 'h-5', filter: 'grayscale invert' },
  { src: '/images/testimonials/feed-studios.png', alt: 'Feed Studios', h: 'h-3.5', filter: 'invert' },
  { src: '/images/testimonials/mae-media.png', alt: 'MAE Media', h: 'h-4', filter: 'invert' },
];

const textMarks = ['Matt Ragland', 'Gigi Robinson'];
---

<section id="logo-strip" class="border-y border-clik-cream/10 bg-clik-cream/5">
  <div class="mx-auto max-w-[1200px] px-6 py-6 md:px-12 md:py-7">
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4 md:gap-x-8">
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/45">
        Trusted by
      </span>
      {logos.map((logo) => (
        <span class="inline-flex h-11 items-center rounded-md bg-clik-cream px-3">
          <img
            src={logo.src}
            alt={logo.alt}
            class={`${logo.h} w-auto mix-blend-multiply ${logo.filter}`}
            loading="lazy"
          />
        </span>
      ))}
      {textMarks.map((name) => (
        <span class="font-mono text-[12px] uppercase tracking-[0.14em] text-clik-cream/55">
          {name}
        </span>
      ))}
      <span class="font-mono text-[12px] uppercase tracking-[0.14em] text-clik-cream/35">
        and more…
      </span>
    </div>
  </div>
</section>
