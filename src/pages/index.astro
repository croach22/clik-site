---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCream from '../components/HeroCream.astro';
import AgencyBandCream from '../components/AgencyBandCream.astro';
import ValueCream from '../components/ValueCream.astro';
import TestimonialVideoCream from '../components/TestimonialVideoCream.astro';
import FeatureEdit from '../components/FeatureEdit';
import FeatureWorkflowAgent from '../components/FeatureWorkflowAgent';
import FeaturePlan from '../components/FeaturePlan';
import ManifestoCream from '../components/ManifestoCream.astro';
import UseCasesCream from '../components/UseCasesCream.astro';
import QuoteCream from '../components/QuoteCream.astro';
import FoundingCTACream from '../components/FoundingCTACream.astro';
import PricingCream from '../components/PricingCream.astro';
import CTACream from '../components/CTACream.astro';
---

<BaseLayout
  title="Clik - AI Agents for Video Editing"
  description="Go from raw footage to a clean, publish-ready edit in minutes. AI video editing built for creators."
  theme="cream"
>
  <div data-section="hero"><HeroCream /></div>
  <div data-section="agency-band"><AgencyBandCream /></div>
  <div data-section="value"><ValueCream /></div>
  <div data-section="testimonial-video"><TestimonialVideoCream /></div>
  <div data-section="social-proof"><QuoteCream /></div>
  <div id="feature-edit" data-section="feature-edit"><FeatureEdit client:load /></div>
  <div id="feature-workflow-agent" data-section="feature-workflow-agent"><FeatureWorkflowAgent client:load /></div>
  <div id="feature-plan" data-section="feature-plan"><FeaturePlan client:load /></div>
  <div data-section="manifesto"><ManifestoCream /></div>
  <div data-section="formats"><UseCasesCream /></div>
  <div data-section="founding-cta"><FoundingCTACream /></div>
  <div data-section="pricing"><PricingCream /></div>
  <div data-section="cta"><CTACream /></div>
</BaseLayout>
