---
// Fan-page / community-account autopilot — standalone card, deliberately not
// merged into the editor comparison. Conceptual for now (no proof stats yet);
// templated workflow subpages that deep-link into the app are phase two.
---

<section id="autopilot" class="px-6 md:px-12 py-24 md:py-32">
  <div class="mx-auto max-w-[1100px]">
    <div class="clik-section-header">
      <span class="idx">[ 04 ]</span>
      <span class="rule"></span>
      <span class="label">AUTOPILOT</span>
    </div>

    <div
      class="relative rounded-[17px] p-px"
      style="background: linear-gradient(120deg, rgba(84, 129, 232, 0.55), rgba(84, 129, 232, 0.10) 30%, rgba(249, 131, 142, 0.10) 70%, rgba(249, 131, 142, 0.5));"
    >
    <div
      class="bento-card relative overflow-hidden" style="background: #101B3E; color: var(--clik-cream); padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px);"
    >
      <div
        class="glow -right-24 -top-24 h-[360px] w-[520px]"
        style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.14), transparent 72%);"
        aria-hidden="true"
      ></div>

      <span class="clik-chip clik-chip-fill-royce">Fan pages · Community accounts</span>

      <!-- Headline left, body right — fills the card width at a readable measure -->
      <div class="relative mt-6 grid gap-x-12 gap-y-5 md:grid-cols-2 md:items-end">
        <h2
          class="font-display font-medium text-clik-cream"
          style="font-size: clamp(28px, 3.5vw, 40px); line-height: 1.15; letter-spacing: -0.02em; max-width: 24ch;"
        >
          Run your secondary accounts on autopilot<span class="clik-period">.</span>
        </h2>

        <p class="font-ui text-clik-cream/70" style="font-size: 17px; line-height: 1.55;">
          Scale output to fan pages and community accounts without hiring clippers to run them. Same engine, same brand rules, pointed at the accounts you never have time for.
        </p>
      </div>

      <a
        href="https://app.clik.vision/sign-up"
        class="mt-8 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce no-underline hover:opacity-80"
      >
        Put an account on autopilot <span aria-hidden="true">→</span>
      </a>
    </div>
    </div>
  </div>
</section>
