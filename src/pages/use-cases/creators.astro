---
// For Creators — the content engine, sized for one person.
// Engine positioning: volume/efficiency/scale. Dark bento system.
import BaseLayout from '../../layouts/BaseLayout.astro';

const CARD = 'border-color: rgba(249, 247, 241, 0.10); background: rgba(249, 247, 241, 0.03);';

const engine = [
  {
    title: 'One shoot becomes many videos',
    body: 'The hero edit. The shorts. The alt hooks. The thumbnail moments. Clik reads the whole batch and plans every video that’s in it — you never sort a file.',
    accent: '#5481E8',
  },
  {
    title: 'The agent finds what you missed',
    body: "Clik watches the whole shoot, not just the takes you remember. The line you said off-script, the moment between cuts, the alt take that's actually better — all surfaced, all searchable.",
    accent: '#F9838E',
  },
  {
    title: 'You direct. Clik builds.',
    body: 'Tell Clik what you want — punchier hook, slower pace, swap the B-roll, cut the dead space. It does the timeline work. You make the calls.',
    accent: '#9785B8',
  },
];

const steps = [
  {
    title: 'Upload your shoot and your idea.',
    body: 'Drop in your footage. Tell Clik what you’re making — a vlog, a recipe, a tutorial, a sit-down talk. Drop in a rough script if you have one.',
  },
  {
    title: 'Clik plans every video in the batch.',
    body: 'It reads the footage, finds your hooks, flags what’s missing, and lays out the slate — long-form for YouTube, verticals for TikTok and Reels, alt hooks for testing.',
  },
  {
    title: 'The build agent constructs the drafts.',
    body: 'Every planned video lands ~90% done, cut to your style. Your caption look, your pacing, your format rules — remembered from last time.',
  },
  {
    title: 'Finish your way.',
    body: "Polish in Clik's web editor — captions, swaps, trims. Or export XML to Premiere Pro, DaVinci Resolve, or Final Cut Pro when you want full control.",
  },
];

const testimonials = [
  {
    quote: 'This just turned an 8 hour edit process into 2. I went from opening my computer to posting on YouTube in 2 hours. It was magical.',
    author: 'Matt Ragland',
    handle: 'YouTuber',
  },
  {
    quote: 'Clik has completely changed not only how I edit but how I film. What used to take over two hours now takes 20 minutes.',
    author: 'Randy Stoever',
    handle: '@hotoffthestoever',
  },
  {
    quote: "I've tried so many AI content tools — Clik is my favorite by far.",
    author: 'Gigi Robinson',
    handle: '@itsgigirobinson',
  },
];
---

<BaseLayout
  title="Clik for Creators — A content engine for one"
  description="Point Clik at a shoot day. It sorts the footage, plans every video in it, and builds the drafts — so you post for a week off one upload."
  theme="midnight"
>

  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 md:pt-36">
    <div class="dot-grid absolute inset-x-0 top-0 h-[520px]" aria-hidden="true"></div>
    <div
      class="glow -top-24 left-[-10%] h-[420px] w-[640px]"
      style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.14), transparent 72%);"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-[1200px] px-6 md:px-12 pb-16">
      <div class="w-full py-8 md:py-10">
        <div class="flex items-center gap-3">
          <span class="h-4 w-[3px] rounded-full bg-clik-royce" aria-hidden="true"></span>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">For Creators</p>
        </div>

        <h1
          class="mt-6 font-display font-medium tracking-display text-clik-cream"
          style="font-size: clamp(44px, 7vw, 68px); line-height: 1.04; letter-spacing: -0.02em; max-width: 18ch;"
        >
          A whole content team. Population: you<span class="clik-period">.</span>
        </h1>

        <p class="mt-6 max-w-[620px] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.55;">
          Point Clik at a shoot day. It sorts the footage, plans every video in it, and builds the drafts — so you post for a week off one upload.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="https://app.clik.vision/sign-up" class="clik-btn clik-btn-primary">
            Start for free <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- [01] Problem -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 01 ]</span>
        <span class="rule"></span>
        <span class="label">THE PROBLEM</span>
      </div>
    </div>
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display font-medium text-clik-cream mb-8" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em; max-width: 22ch;">
        You film more than you post. And it’s killing you<span class="clik-period">.</span>
      </h2>
      <p class="font-ui text-clik-cream/70 mb-6" style="font-size: 18px; line-height: 1.6;">
        The ideas are there. The footage is there. Your drive is a graveyard of stuff that could’ve been a hit if you’d just had time to cut it.
      </p>
      <p class="font-ui text-clik-cream/70 mb-6" style="font-size: 18px; line-height: 1.6;">
        Instead it’s Sunday night again. You’re 6 hours into a timeline. The clip you actually want is buried somewhere on hour 3 of the shoot. You’re going to post late. You’re going to post one thing instead of three. And on Monday you’ll watch someone else post the exact idea you had three weeks ago.
      </p>
      <p class="font-ui text-clik-cream mb-0 font-semibold" style="font-size: 18px; line-height: 1.6;">
        Editing isn’t the part of this you love. It’s the part you survive.
      </p>
    </div>
  </section>

  <!-- [02] Day one -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 02 ]</span>
        <span class="rule"></span>
        <span class="label">DAY ONE</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-4 max-w-[22ch]" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        What the engine does before you’d even open a timeline<span class="clik-period">.</span>
      </h2>
      <p class="font-ui text-clik-cream/70 mb-12 max-w-[60ch]" style="font-size: 18px; line-height: 1.6;">
        Upload a shoot. Tell Clik what you’re making. Before you’d normally finish a first cut, it has already done two things.
      </p>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- LEFT: Shoot breakdown -->
        <div class="bento-card border flex flex-col" style={`${CARD} padding: 32px;`}>
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
            01 · Shoot Breakdown
          </p>
          <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(22px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em;">
            Every moment, sorted and surfaced.
          </h3>
          <p class="font-ui text-clik-cream/70 mb-6" style="font-size: 16px; line-height: 1.55;">
            Clik reads the whole batch and tells you what’s there. Hooks, B-roll, the line you forgot you said, the candid moment between takes. Searchable, taggable, ready to build with.
          </p>

          <div class="mt-auto rounded-xl border border-clik-cream/10 bg-clik-cream/[0.04] p-5">
            <div class="flex items-center justify-between border-b border-clik-cream/10 pb-3 mb-4">
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/55">
                Morning Routine — Vlog
              </span>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-royce font-bold">
                14 / 16 beats captured
              </span>
            </div>
            <ul class="space-y-2.5 font-ui text-clik-cream/85" style="font-size: 14px; line-height: 1.5;">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/20 font-mono text-[10px] font-bold text-clik-royce">✓</span>
                Hook: "this is my non-negotiable" at 00:08
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/20 font-mono text-[10px] font-bold text-clik-royce">✓</span>
                Coffee pour, B-roll
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-salmon/25 font-mono text-[10px] font-bold text-clik-salmon">✗</span>
                Missing: closing CTA — "comment your routine"
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-salmon/25 font-mono text-[10px] font-bold text-clik-salmon">✗</span>
                Missing: phone notification cutaway (mentioned in script)
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/10 font-mono text-[10px] font-bold text-clik-royce">+</span>
                Off-script: matcha spill bit at 04:22 — great alt hook
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-clik-royce/10 font-mono text-[10px] font-bold text-clik-royce">+</span>
                Bonus: window light close-up — works as B-roll on three drafts
              </li>
            </ul>
          </div>
        </div>

        <!-- RIGHT: First drafts speed -->
        <div class="bento-card border flex flex-col" style={`${CARD} padding: 32px;`}>
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
            02 · First Drafts
          </p>
          <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(22px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em;">
            Drafts in 12 minutes, not all weekend.
          </h3>
          <p class="font-ui text-clik-cream/70 mb-8" style="font-size: 16px; line-height: 1.55;">
            Every format your shoot can become — the long-form hero, the short, the alt-hook A/B — lands as a ~90%-done draft. You open them, pick the takes you love, and ship.
          </p>

          <div class="mt-auto space-y-3">
            <div class="rounded-xl border p-6" style="border-color: rgba(84, 129, 232, 0.4); background: rgba(84, 129, 232, 0.10);">
              <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-royce mb-2 font-bold">
                With Clik
              </p>
              <p class="font-display font-medium text-clik-cream" style="font-size: clamp(44px, 6vw, 64px); line-height: 1; letter-spacing: -0.03em;">
                12 min
              </p>
              <p class="mt-2 font-ui text-clik-cream/70" style="font-size: 14px; line-height: 1.5;">
                One shoot in. Every format out — as ~90%-done drafts.
              </p>
            </div>

            <div class="rounded-xl border border-clik-cream/10 bg-clik-cream/[0.04] p-5">
              <div class="flex items-baseline justify-between">
                <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55 font-bold">
                  Editing it yourself
                </p>
                <p class="font-display font-medium text-clik-cream/55" style="font-size: 28px; line-height: 1; letter-spacing: -0.02em;">
                  All weekend
                </p>
              </div>
              <p class="mt-2 font-ui text-clik-cream/55" style="font-size: 13px; line-height: 1.5;">
                Per format. And you’ve only got so many weekends.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- [03] The engine -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 03 ]</span>
        <span class="rule"></span>
        <span class="label">THE ENGINE</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-12 max-w-[24ch]" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        The reason you’ll post more<span class="clik-period">.</span>
      </h2>

      <div class="grid gap-5 md:grid-cols-3">
        {engine.map((cap) => (
          <div class="bento-card border" style={`${CARD} padding: 28px;`}>
            <span
              class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-lg text-sm"
              style={`color: ${cap.accent}; background: ${cap.accent}14; border: 1px solid ${cap.accent}35;`}
              aria-hidden="true"
            >✦</span>
            <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(20px, 2.2vw, 24px); line-height: 1.2; letter-spacing: -0.01em;">
              {cap.title}<span class="clik-period">.</span>
            </h3>
            <p class="font-ui text-clik-cream/70" style="font-size: 16px; line-height: 1.6;">
              {cap.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- [04] The workflow -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 04 ]</span>
        <span class="rule"></span>
        <span class="label">THE WORKFLOW</span>
      </div>
    </div>
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display font-medium text-clik-cream mb-12 text-center" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        How it works<span class="clik-period">.</span>
      </h2>

      <ol class="space-y-5">
        {steps.map((step, i) => (
          <li class="bento-card border flex gap-5" style={`${CARD} padding: 28px;`}>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border font-mono text-sm font-bold text-clik-royce" style="border-color: rgba(84, 129, 232, 0.4); background: rgba(84, 129, 232, 0.12);">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <p class="mb-2 font-display font-medium text-clik-cream" style="font-size: 20px; line-height: 1.2; letter-spacing: -0.01em;">{step.title}</p>
              <p class="font-ui text-clik-cream/70" style="font-size: 16px; line-height: 1.55;">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-10 font-ui text-clik-cream/70 text-center" style="font-size: 18px; line-height: 1.6;">
        Same shoot. A week of content.
      </p>
    </div>
  </section>

  <!-- [05] Proof -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 05 ]</span>
        <span class="rule"></span>
        <span class="label">PROOF</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <div class="grid gap-5 md:grid-cols-3">
        {testimonials.map((t) => (
          <div class="bento-card border flex flex-col" style={`${CARD} padding: 28px;`}>
            <p class="font-ui text-clik-cream/85 leading-relaxed mb-5" style="font-size: 16px;">
              "{t.quote}"
            </p>
            <p class="mt-auto font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/70">
              <span class="font-bold text-clik-cream">{t.author}</span>
              <span class="text-clik-cream/45"> · {t.handle}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- [06] Final CTA -->
  <section class="px-6 md:px-12 py-16 md:py-28">
    <div class="mx-auto max-w-[1200px]">
      <div class="clik-section-header mb-8">
        <span class="idx">[ 06 ]</span>
        <span class="rule"></span>
        <span class="label">START</span>
      </div>
      <div
        class="on-midnight relative overflow-hidden"
        style="background: #13204A; border: 1px solid rgba(249, 247, 241, 0.10); border-radius: 12px; padding: clamp(48px, 7vw, 96px) clamp(24px, 5vw, 64px); color: var(--clik-cream);"
      >
        <div
          class="glow -left-32 -top-32 h-[420px] w-[640px]"
          style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.20), transparent 72%);"
          aria-hidden="true"
        ></div>
        <h2 class="font-display font-medium text-clik-cream" style="font-size: clamp(40px, 6vw, 68px); line-height: 1; letter-spacing: -0.02em; max-width: 16ch;">
          Film once. Post for a week<span class="clik-period">.</span>
        </h2>
        <p class="mt-6 max-w-[52ch] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.55;">
          Run your first project free. See what’s actually in your footage.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="https://app.clik.vision/sign-up" class="clik-btn clik-btn-light">
            Start for free <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
