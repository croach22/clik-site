---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const year = new Date().getFullYear();
---

<footer class="on-midnight" style="background: var(--clik-midnight); color: var(--clik-cream); padding: 64px 24px 40px; margin-top: 64px;">
  <div class="mx-auto max-w-[1200px]">

    <!-- Top: 4-col grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 items-start">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="inline-block mb-4">
          <img src="/logo-white.svg" alt="Clik" class="h-7 w-auto" />
        </a>
        <p class="font-ui text-clik-cream/55 max-w-[34ch]" style="font-size: 14px; line-height: 1.55;">
          AI agents for video editing. Talk to your footage.
        </p>
      </div>

      <!-- Product -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55 mb-4">PRODUCT</p>
        <ul class="space-y-2.5 font-ui" style="font-size: 14px;">
          <li><a href="/#features" class="text-clik-cream/80 hover:text-clik-cream transition-colors">Features</a></li>
          <li><a href="/#pricing" class="text-clik-cream/80 hover:text-clik-cream transition-colors">Pricing</a></li>
          <li><a href="/docs" class="text-clik-cream/80 hover:text-clik-cream transition-colors">Docs</a></li>
        </ul>
      </div>

      <!-- Blog -->
      <div>
        <a href="/blog" class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55 mb-4 block hover:text-clik-cream transition-colors">BLOG</a>
        <ul class="space-y-2.5 font-ui" style="font-size: 14px;">
          {posts.slice(0, 4).map((post) => (
            <li>
              <a href={`/blog/${post.slug}`} class="text-clik-cream/80 hover:text-clik-cream transition-colors line-clamp-1">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55 mb-4">COMPANY</p>
        <ul class="space-y-2.5 font-ui" style="font-size: 14px;">
          <li><a href="/founding-creators" class="text-clik-royce hover:opacity-80 transition-opacity">Founding Creators</a></li>
          <li><a href="mailto:conner@clik.vision" class="text-clik-cream/80 hover:text-clik-cream transition-colors">Contact</a></li>
          <li><a href="https://www.instagram.com/clik.ai/" class="text-clik-cream/80 hover:text-clik-cream transition-colors">Instagram</a></li>
          <li><a href="https://www.linkedin.com/company/clik-vision" class="text-clik-cream/80 hover:text-clik-cream transition-colors">LinkedIn</a></li>
          <li><a href="/terms" class="text-clik-cream/80 hover:text-clik-cream transition-colors">Terms</a></li>
          <li><a href="/privacy" class="text-clik-cream/80 hover:text-clik-cream transition-colors">Privacy</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3" style="border-top: 1px solid var(--clik-cream-12);">
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55">
        © {year} CLIK · ALL TAKES RESERVED
      </span>
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55">
        VIBES · GOOD
      </span>
    </div>

  </div>
</footer>
