---
// Cream-surface Pricing — kit pattern: 3 cards (Free / Creator / Pro) w/ KV metadata,
// Pro featured Royce. Agency plans live in a separate callout below the grid (linked out to /use-cases/agencies).
type Tier = {
  idx: string;
  name: string;
  price: string;
  period: string;
  featured: boolean;
  kv: [string, string][];
  cta: string;
  ctaHref: string;
  exportsTo?: ('adobe' | 'davinci' | 'finalcut')[];
};

const tiers: Tier[] = [
  {
    idx: '01',
    name: 'Free',
    price: '$0',
    period: '/mo',
    featured: false,
    kv: [
      ['FOOTAGE',  '1H / MO'],
      ['EXPORT',   '720P'],
      ['PROJECTS', '3'],
      ['BEST FOR',  'TRYING IT OUT'],
    ],
    cta: 'Start for free',
    ctaHref: 'https://app.clik.vision/sign-up',
  },
  {
    idx: '02',
    name: 'Creator',
    price: '$29',
    period: '/mo',
    featured: false,
    kv: [
      ['FOOTAGE',  '3H / MO'],
      ['EXPORT',   '1080P'],
      ['PROJECTS', '20'],
      ['BEST FOR',  'POSTING WEEKLY'],
    ],
    cta: 'Get started',
    ctaHref: 'https://app.clik.vision/sign-up',
  },
  {
    idx: '03',
    name: 'Pro',
    price: '$59',
    period: '/mo',
    featured: true,
    kv: [
      ['FOOTAGE',  '6H / MO'],
      ['EXPORT',   'XML · 4K SOON'],
      ['PROJECTS', '40'],
      ['BEST FOR',  'RUNNING A CHANNEL'],
    ],
    cta: 'Get started',
    ctaHref: 'https://app.clik.vision/sign-up',
    exportsTo: ['adobe', 'davinci', 'finalcut'],
  },
];

// App-tile icons — small rounded-square abbreviations in midnight, palette-consistent.
const ICONS: Record<NonNullable<Tier['exportsTo']>[number], { label: string; abbr: string }> = {
  adobe:    { label: 'Adobe Premiere Pro', abbr: 'Pr'  },
  davinci:  { label: 'DaVinci Resolve',    abbr: 'DR'  },
  finalcut: { label: 'Final Cut Pro',      abbr: 'FCP' },
};
---

<section id="pricing" class="px-6 md:px-12 py-24 md:py-32">
  <div class="mx-auto max-w-[1200px]">
    <div class="clik-section-header">
      <span class="idx">[ 05 ]</span>
      <span class="rule"></span>
      <span class="label">PRICING</span>
    </div>

    <h2 class="font-display font-medium text-clik-cream" style="font-size: clamp(36px, 4.5vw, 46px); line-height: 1.05; letter-spacing: -0.02em; max-width: 18ch;">
      Start free. Scale when it's working<span class="clik-period">.</span>
    </h2>

    <p class="mt-5 mb-12 font-ui text-clik-cream/70" style="font-size: 17px; line-height: 1.55; max-width: 66ch;">
      Every plan runs the same engine. What changes is how much footage you can put through it, and how you get the videos out.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pricing-grid">
      {tiers.map((t) => (
        <div class={`clik-card ${t.featured ? 'is-featured' : ''} flex flex-col gap-4 relative`} style="padding: 28px 24px;">
          {t.featured && (
            <span
              class="clik-chip clik-chip-fill-royce absolute -top-3 left-6"
              style="font-size: 9px;"
            >POPULAR</span>
          )}

          <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55">
            PLAN · {t.idx}
          </div>
          <div class="font-display font-medium text-clik-cream" style="font-size: 30px; line-height: 1.1; letter-spacing: -0.02em;">
            {t.name}
          </div>
          <div>
            <span class="font-ui font-extrabold text-clik-cream" style="font-size: 34px;">{t.price}</span>
            {t.period && <span class="font-ui text-clik-cream/55" style="font-size: 14px;">{` ${t.period}`}</span>}
          </div>

          <div class="clik-kv">
            {t.kv.map(([k, v]) => (
              <div class={`row ${k === 'VIBES' ? 'vibes' : ''}`}>
                <span>{k}</span><span class="v">{v}</span>
              </div>
            ))}
          </div>

          {t.exportsTo && (
            <div class="flex items-center gap-3 mt-1">
              <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-clik-cream/55">
                WORKS WITH
              </span>
              <div class="flex items-center gap-1.5">
                {t.exportsTo.map((key) => (
                  <span class="works-tile" title={ICONS[key].label} aria-label={ICONS[key].label}>
                    {ICONS[key].abbr}
                  </span>
                ))}
              </div>
            </div>
          )}

          <a
            href={t.ctaHref}
            class={`clik-btn ${t.featured ? 'clik-btn-primary' : 'clik-btn-secondary'} mt-auto w-full justify-center`}
          >
            {t.cta}
          </a>
        </div>
      ))}
    </div>

    <!-- Agency callout — smaller treatment below the 3-tier grid -->
    <a
      href="/use-cases/agencies#agency-plans"
      data-track-click="AgencyPricingClick"
      data-track-params={JSON.stringify({ audience: 'agency', surface: 'pricing' })}
      data-track-view="AgencyPricingView"
      class="group mt-8 block rounded-2xl border border-clik-cream/12 bg-clik-cream/5 p-6 md:p-7 transition-colors hover:border-clik-cream/25"
    >
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-8">
        <div class="flex-1">
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce font-bold">
            For Agencies
          </p>
          <p class="font-display font-medium text-clik-cream" style="font-size: clamp(20px, 2.4vw, 24px); line-height: 1.25; letter-spacing: -0.01em;">
            Plans from <span class="text-clik-royce">$499 / mo</span>, built around your monthly volume.
          </p>
          <p class="mt-2 font-ui text-clik-cream/65" style="font-size: 14px; line-height: 1.5;">
            We set your brand rules and workflows up with you, so your team directs the work instead of learning a tool.
          </p>
        </div>
        <span class="clik-btn clik-btn-secondary shrink-0 group-hover:border-clik-midnight">
          See agency plans <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>
  </div>
</section>

<style>
  .works-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    min-width: 22px;
    padding: 0 5px;
    border: 1px solid var(--clik-mid-25);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--clik-midnight);
    background: var(--clik-cream);
    line-height: 1;
  }
</style>
