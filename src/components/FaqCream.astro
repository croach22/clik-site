---
// FAQ — native <details>/<summary>, zero JS island cost, plus FAQPage JSON-LD.
// "Fit with my existing team" is deliberately reframed from "Does Clik replace
// my editor?" — editor substitution is our internal metric; capacity is the
// external language.
const faqs = [
  {
    q: 'How does Clik fit with my existing team?',
    a: "Two modes. Some teams run content on full autopilot. Others want closer attention and review or adjust output in Clik's built-in editor.",
  },
  {
    q: 'Do you support multicam?',
    a: "Not yet. It's on the roadmap and one of our most-requested features.",
  },
  {
    // TODO(conner): VERIFY before deploy — confirm mobile upload/trigger is
    // shipped, not roadmap.
    q: 'Do you have a mobile app?',
    a: 'Yes — upload footage and trigger projects from mobile. The rest of the workflow happens in Clik.',
  },
  {
    q: 'Is there a free trial?',
    a: "There's a free version instead — run one full project on the free tier, no credit card required. Pick a plan when you're ready to scale.",
  },
  {
    q: 'What do exports look like?',
    a: 'XML export for all major NLEs — DaVinci Resolve, Premiere Pro, Final Cut Pro.',
  },
  {
    q: 'Who owns my data?',
    a: "You do. We don't train models on your content, and we don't sell it. Everything is stored securely and privately.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="px-6 md:px-12 py-24 md:py-32">
  <div class="mx-auto max-w-[900px]">
    <div class="clik-section-header">
      <span class="idx">[ 11 ]</span>
      <span class="rule"></span>
      <span class="label">FAQ</span>
    </div>

    <h2
      class="font-display font-medium text-clik-midnight"
      style="font-size: clamp(36px, 4.5vw, 46px); line-height: 1.1; letter-spacing: -0.02em;"
    >
      Common questions<span class="clik-period">.</span>
    </h2>

    <div class="mt-10">
      {faqs.map((f) => (
        <details class="faq-item group">
          <summary class="faq-summary">
            <span class="font-display font-medium text-clik-midnight" style="font-size: 19px; letter-spacing: -0.01em;">
              {f.q}
            </span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p class="pb-6 pr-10 font-ui text-clik-midnight/70" style="font-size: 15px; line-height: 1.6; max-width: 62ch;">
            {f.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-item {
    border-bottom: 1px solid var(--clik-mid-12);
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  /* Plus → minus indicator */
  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    opacity: 0.45;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--clik-midnight);
    transition: transform var(--dur-base) var(--ease-soft);
  }
  .faq-icon::before { width: 14px; height: 1.5px; }
  .faq-icon::after  { width: 1.5px; height: 14px; }
  details[open] .faq-icon::after {
    transform: rotate(90deg);
  }
</style>
