---
// Cream Quote section — kit pattern: hero bracket-framed quote +
// marquee of supporting quotes underneath, all in cream surface w/ mono attribution.
const hero = {
  quote: "Clik finds extra concepts in my footage that a traditional editor would never bother to pull. Same shoot, more deliverables, less time.",
  author: "BOBBY",
  handle: "FOUNDER, MAE MEDIA",
  avatar: "/images/testimonials/mae-media.png",
  avatarKind: "logo" as const,
};

const others = [
  { quote: "This just turned an 8 hour edit process into 2. I went from opening my computer to posting on YouTube in 2 hours. It was magical.", author: "MATT RAGLAND", handle: "YOUTUBER", avatar: "/images/testimonials/matt-ragland.jpg", avatarKind: "photo" as const },
  { quote: "This totally changes how we work. With drafts ready instantly, our creative directors take projects deeper and iterate faster. Our editors just make finishing touches. Now we can scale without hiring more editors.", author: "FEED STUDIOS LA", handle: "CONTENT AGENCY", avatar: "/images/testimonials/feed-studios.png", avatarKind: "logo" as const },
  { quote: "This will totally change how people create content.", author: "ZACH NEMAN", handle: "@CHEFFINWITHZACH", avatar: "/images/testimonials/zach-neman.jpg", avatarKind: "photo" as const },
  { quote: "Clik has completely changed not only how I edit but how I film. What used to take over two hours now takes 20 minutes, and I enjoy the entire process around cooking content much more now.", author: "RANDY STOEVER", handle: "@HOTOFFTHESTOEVER", avatar: "/images/testimonials/randy-stoever.jpg", avatarKind: "photo" as const },
  { quote: "I've tried so many AI content tools; Clik is my favorite by far.", author: "GIGI ROBINSON", handle: "@ITSGIGIROBINSON", avatar: "/images/testimonials/gigi-robinson.jpg", avatarKind: "photo" as const },
];
---

<section class="px-6 md:px-12 py-24 md:py-32 overflow-hidden">
  <div class="mx-auto max-w-[1100px]">
    <div class="clik-section-header">
      <span class="idx">[ 02 ]</span>
      <span class="rule"></span>
      <span class="label">VOICES</span>
    </div>

    <!-- Hero quote — bracket-framed window -->
    <div
      class="clik-frame relative"
      style="color: var(--clik-midnight); padding: 56px clamp(24px, 5vw, 64px);"
    >
      <span class="clik-corner-tr"></span>
      <span class="clik-corner-bl"></span>

      <p
        class="font-display font-medium italic text-clik-midnight"
        style="font-size: clamp(26px, 3.4vw, 38px); line-height: 1.25; letter-spacing: -0.01em; max-width: 42ch;"
      >
        "{hero.quote}"
      </p>
      <div class="mt-8 flex items-center gap-3">
        {hero.avatar && hero.avatarKind === 'photo' && (
          <img
            src={hero.avatar}
            alt={hero.author}
            class="h-10 w-10 rounded-full object-cover ring-1 ring-clik-midnight/15"
            loading="lazy"
          />
        )}
        {hero.avatar && hero.avatarKind === 'logo' && (
          <span class="inline-flex h-7 items-center rounded-md bg-clik-midnight px-2.5">
            <img src={hero.avatar} alt={hero.author} class="h-3 w-auto" loading="lazy" />
          </span>
        )}
        <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-midnight/70">
          {hero.author} · {hero.handle}
        </div>
      </div>
    </div>
  </div>

  <!-- Supporting marquee -->
  <div class="mt-16 marquee-row">
    <div class="marquee-track">
      {[...others, ...others, ...others].map((t) => (
        <div
          class="marquee-card flex-shrink-0 w-[360px] clik-frame relative bg-clik-cream flex flex-col"
          style="color: var(--clik-midnight); padding: 24px; min-height: 220px;"
        >
          <span class="clik-corner-tr"></span>
          <span class="clik-corner-bl"></span>
          <p class="font-ui text-clik-midnight" style="font-size: 15px; line-height: 1.55;">"{t.quote}"</p>
          <div class="mt-auto pt-4 flex items-center gap-2.5">
            {t.avatar && t.avatarKind === 'photo' && (
              <img
                src={t.avatar}
                alt={t.author}
                class="h-8 w-8 rounded-full object-cover ring-1 ring-clik-midnight/15"
                loading="lazy"
              />
            )}
            {t.avatar && t.avatarKind === 'logo' && (
              <span class="inline-flex h-6 items-center rounded-md bg-clik-midnight px-2">
                <img src={t.avatar} alt={t.author} class="h-2.5 w-auto" loading="lazy" />
              </span>
            )}
            <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/55">
              {t.author} · {t.handle}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-row {
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: clik-marquee 60s linear infinite;
  }
  .marquee-row:hover .marquee-track { animation-play-state: paused; }
  @keyframes clik-marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
</style>
