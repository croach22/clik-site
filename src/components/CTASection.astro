<section class="relative px-6 py-20 md:py-32">
  <div class="pointer-events-none absolute left-1/2 top-1/2 h-[300px] w-[300px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-violet-600/10 blur-[100px]"></div>
  <div class="relative mx-auto max-w-3xl text-center">
    <h2 class="mb-6 text-4xl font-bold text-white md:text-6xl">
      Start editing smarter<br />
      <span class="gradient-text">today.</span>
    </h2>
    <p class="mb-10 text-lg text-zinc-400">
      Upload your first video free. No credit card required.
    </p>
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href="https://app.clik.vision/sign-up"
        class="inline-block rounded-full bg-white px-10 py-4 text-base font-semibold text-zinc-950 transition-opacity hover:opacity-90"
      >
        Start for Free
      </a>
      <a
        href="https://calendly.com/clikphotos/clik-agency-demo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full border border-white/15 px-10 py-4 text-base font-medium text-zinc-300 transition-colors hover:border-white/25 hover:text-white"
      >
        Book a Demo
      </a>
    </div>
  </div>
</section>
