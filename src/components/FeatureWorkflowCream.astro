---
// Workflow Agent — kit-style feature: batch in / multi-draft out terminal demo.
const kv = [
  ['JOB',       'WORKFLOW AGENT'],
  ['INPUT',     'SHOOT DAY + BRIEF'],
  ['OUTPUT',    'LONG-FORM + SHORTS'],
  ['EDITING',   'BRIEF-DRIVEN'],
  ['SCRUBBING', 'NONE'],
  ['SOURCE',    'UNTOUCHED'],
  ['VIBES',     'CREATIVE TEAM'],
];

const inputs = [
  { name: 'shoot_day_01.mp4', size: '2.4 GB' },
  { name: 'shoot_day_02.mp4', size: '1.8 GB' },
  { name: 'shoot_day_03.mp4', size: '3.1 GB' },
  { name: 'brief.pdf',        size: '420 KB' },
];

const outputs = [
  { label: 'Full Episode Rough Cut',   duration: '12:34' },
  { label: 'Short 1 — Hook A',         duration: '0:42'  },
  { label: 'Short 2 — Hook B',         duration: '0:38'  },
  { label: 'Short 3 — Script 2',       duration: '0:58'  },
];
---

<section id="feature-workflow-agent" class="px-6 md:px-12 py-24 md:py-32 bg-clik-bone/40">
  <div class="mx-auto max-w-[1200px]">
    <div class="clik-section-header">
      <span class="idx">[ 02 ]</span>
      <span class="rule"></span>
      <span class="label">WORKFLOW AGENT · NEW</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Terminal demo (left this time for variety) -->
      <div class="order-2 lg:order-1">
        <div
          class="clik-frame relative bg-clik-cream"
          style="color: var(--clik-midnight); border-radius: 2px; padding: 28px 26px;"
        >
          <span class="clik-corner-tr"></span>
          <span class="clik-corner-bl"></span>

          <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce mb-4">
            BATCH 04 · TAKES 01–47
          </div>

          <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/45 mb-2">INPUT</div>
          <div class="space-y-1 mb-5">
            {inputs.map((f) => (
              <div class="flex items-center justify-between font-mono text-[12px] text-clik-midnight">
                <span><span class="text-clik-salmon">›</span> {f.name}</span>
                <span class="text-clik-midnight/45 text-[10px]">{f.size}</span>
              </div>
            ))}
          </div>

          <div class="text-clik-royce font-mono text-[12px] flex items-center gap-2 mb-5">
            <span class="inline-block animate-spin">↻</span>
            processing batch · matching to brief
          </div>

          <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/45 mb-2">OUTPUT</div>
          <div class="space-y-1">
            {outputs.map((o) => (
              <div class="flex items-center justify-between font-mono text-[12px] text-clik-midnight/70">
                <span class="flex items-center gap-2">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-clik-royce"></span>
                  {o.label}
                </span>
                <span class="text-clik-midnight/45 text-[10px]">{o.duration}</span>
              </div>
            ))}
          </div>

          <div class="mt-5 font-mono text-[9px] uppercase tracking-[0.14em] text-clik-midnight/45">
            ✓ 4 DRAFTS READY · BRIEF MATCHED
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <h2 class="font-display font-medium text-clik-midnight" style="font-size: clamp(36px, 4.5vw, 46px); line-height: 1.05; letter-spacing: -0.02em;">
          Shoot day in.<br/>Multiple drafts out<span class="clik-period">.</span>
        </h2>
        <p class="mt-5 max-w-[48ch] font-ui text-clik-midnight/70" style="font-size: 18px; line-height: 1.55;">
          Feed the agent batch footage from a shoot day plus your creative brief. It returns a long-form rough cut and a curated set of shorts, all configured to the brief. Editors just polish.
        </p>
        <div class="clik-kv mt-8 max-w-[380px]">
          {kv.map(([k, v]) => (
            <div class={`row ${k === 'VIBES' ? 'vibes' : ''}`}>
              <span>{k}</span><span class="v">{v}</span>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <a
            href="https://calendly.com/clikphotos/clik-agency-demo"
            target="_blank"
            rel="noopener noreferrer"
            class="clik-btn clik-btn-primary"
          >
            Book a demo <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes _clik_spin { to { transform: rotate(360deg); } }
  .animate-spin { animation: _clik_spin 0.9s linear infinite; display: inline-block; }
</style>
