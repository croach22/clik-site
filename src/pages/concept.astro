---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptChat from '../components/ConceptChat.tsx';
---

<BaseLayout title="Clik — Concept" theme="cream">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-24 relative">

    <!-- Headline -->
    <h1 class="text-center font-display font-medium leading-[1.05] mb-6 max-w-2xl text-clik-midnight" style="font-size: clamp(40px, 6vw, 64px); letter-spacing: -0.02em;">
      The AI creative assistant<br />
      for video creators<span class="clik-period">.</span>
    </h1>

    <!-- Subtext -->
    <p class="font-ui text-clik-midnight/70 text-center mb-12 max-w-xl leading-relaxed" style="font-size: 18px;">
      Plan content, shape your story, and edit real footage 10x faster —<br class="hidden md:block" /> without losing creative control.
    </p>

    <!-- Chat -->
    <div class="w-full max-w-2xl relative">
      <ConceptChat client:load />
    </div>

  </main>
</BaseLayout>
