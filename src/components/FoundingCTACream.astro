---

<section class="px-6 md:px-12 py-20">
  <div class="mx-auto max-w-[1200px] mb-8">
    <div class="clik-section-header justify-center">
      <span class="idx">[ 08 ]</span>
      <span class="rule"></span>
      <span class="label">FOUNDING CREATORS</span>
    </div>
  </div>
  <div class="mx-auto max-w-[900px]">
    <div
      class="clik-frame relative"
      style="color: var(--clik-midnight); padding: clamp(32px, 5vw, 56px) clamp(24px, 5vw, 64px);"
    >
      <span class="clik-corner-tr"></span>
      <span class="clik-corner-bl"></span>

      <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce mb-4">
        FOUNDING CREATOR PROGRAM
      </div>

      <h2 class="font-display font-medium text-clik-midnight" style="font-size: clamp(28px, 3.5vw, 40px); line-height: 1.1; letter-spacing: -0.02em; max-width: 22ch;">
        Get in early. Get paid forever<span class="clik-period">.</span>
      </h2>

      <p class="mt-5 max-w-[52ch] font-ui text-clik-midnight/70" style="font-size: 18px; line-height: 1.55;">
        30% lifetime commission on every creator you refer. We're keeping this small on purpose.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="/founding-creators" class="clik-btn clik-btn-primary">
          Learn more <span aria-hidden="true">→</span>
        </a>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/55">
          LIMITED SPOTS · BY APPLICATION
        </span>
      </div>
    </div>
  </div>
</section>
