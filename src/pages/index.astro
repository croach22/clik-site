---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroAnimated from '../components/HeroAnimated';
import ValueSection from '../components/ValueSection.astro';
import FeaturePlan from '../components/FeaturePlan';
import FeatureEdit from '../components/FeatureEdit';
import ManifestoScroll from '../components/ManifestoScroll';
import UseCasesGrid from '../components/UseCasesGrid';
import SocialProof from '../components/SocialProof.astro';
import CTASection from '../components/CTASection.astro';
import FoundingCTA from '../components/FoundingCTA.astro';
import Pricing from '../components/Pricing.astro';
---

<BaseLayout
  title="Clik — AI Video Editor for Creators"
  description="Go from raw footage to a clean, publish-ready edit in minutes. AI video editing built for creators."
>
  <div data-section="hero"><HeroAnimated client:load /></div>
  <div data-section="value"><ValueSection /></div>
  <div data-section="feature-edit"><FeatureEdit client:load /></div>
  <div data-section="feature-plan"><FeaturePlan client:load /></div>
  <div data-section="use-cases"><UseCasesGrid client:load /></div>
  <div data-section="manifesto"><ManifestoScroll client:load /></div>
  <div data-section="founding-cta"><FoundingCTA /></div>
  <div data-section="social-proof"><SocialProof /></div>
  <div data-section="pricing"><Pricing /></div>
  <div data-section="cta"><CTASection /></div>
</BaseLayout>
