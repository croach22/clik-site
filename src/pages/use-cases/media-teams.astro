---
// For Media Teams — the content engine for shows, podcasts, and publishers.
// New page complementing creators/agencies. Engine positioning, dark bento system.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { StepVisual } from '../../components/FeatureVisuals';

// Finished work from three different input types, so the range is visible
// before anyone reads a word.
const outputs = [
  { label: 'podcast', src: '/videos/showcase/podcast/out-a.mp4', accent: '#5481E8' },
  { label: 'shoot day', src: '/videos/showcase/content-day/out-a.mp4', accent: '#F9838E' },
  { label: 'interview', src: '/videos/showcase/street-interviews/out-a.mp4', accent: '#7CA088' },
];

const CARD = 'border-color: rgba(249, 247, 241, 0.10); background: rgba(249, 247, 241, 0.03);';
const CALENDLY = 'https://calendly.com/clikphotos/clik-agency-demo';

// Same plan and same price as the agency page. Media teams and agencies buy
// the same thing on the same terms, so the pricing must not diverge — if one
// moves, move the other.
const planIncludes = [
  'Shared Slack with the Clik team',
  'Hands-on prompt and workflow help',
  'Feature prioritization based on your needs',
  'Monthly workflow review',
];

const teamFeatures = [
  {
    title: 'Brand memory, per property',
    body: 'Caption styles, title cards, format rules. Saved per property, applied automatically. The fortieth video looks like the fourth, no matter who ran the batch.',
    accent: '#5481E8',
  },
  {
    title: 'A dashboard the whole team sees',
    body: 'Producers watch every video move: planned, building, ready for review. No status meetings, no "where are the clips?" threads.',
    accent: '#F9838E',
  },
  {
    title: 'Native to your post pipeline',
    body: 'Review and finish in Clik’s web editor, or export XML to Premiere Pro, DaVinci Resolve, or Final Cut Pro. Clik feeds your pipeline instead of replacing it.',
    accent: '#9785B8',
  },
];

// The homepage's four steps, said for a team running properties. Deliberately
// not an episode walkthrough: teams shooting content days and field interviews
// run this too.
const steps = [
  {
    title: 'Brand rules, saved per property',
    body: 'Caption styles, title cards, hook rules, format rules. Saved per property and applied automatically, so the fortieth video looks like the fourth no matter who ran the batch.',
  },
  {
    title: 'Clik plans every video',
    body: 'Give it the raw recording, the finished cut, a shoot day, or a field batch, plus your B-roll and graphics. Every strong moment comes back as a planned video with a hook, scope, and duration. Your producer approves.',
  },
  {
    title: 'The editing agent builds them in parallel',
    body: 'Cutaways from your own library and graphics, never stock. Captions and title cards in the property\'s saved style.',
  },
  {
    title: 'The whole team watches it move',
    body: 'Planned, building, ready for review, in one queue. No status meetings. Finish in Clik, or export XML for a final pass in your NLE.',
  },
];
---

<BaseLayout
  title="Clik for Media Teams · Scale your audience with on-brand output"
  description="Point Clik at a show, a shoot day, or a field batch. It plans and builds every video for every channel, on brand, without adding headcount."
  theme="midnight"
>

  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 md:pt-36">
    <div class="dot-grid absolute inset-x-0 top-0 h-[520px]" aria-hidden="true"></div>
    <div
      class="glow -top-24 left-[-10%] h-[420px] w-[640px]"
      style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.14), transparent 72%);"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-[1296px] px-6 md:px-12 pb-16">
      <div class="grid items-center gap-12 py-8 md:py-10 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        <div class="flex items-center gap-3">
          <span class="h-4 w-[3px] rounded-full bg-clik-royce" aria-hidden="true"></span>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">For Media Teams</p>
        </div>

        <h1
          class="mt-6 font-display font-medium tracking-display text-clik-cream"
          style="font-size: clamp(44px, 7vw, 68px); line-height: 1.04; letter-spacing: -0.02em;"
        >
          Scale your audience with on-brand output, every time<span class="clik-period">.</span>
        </h1>

        <p class="mt-6 max-w-[620px] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.55;">
          Clik is the engine behind your properties. Point it at a show, a shoot day, or a field batch, and it comes back planned, built, and on brand for every channel, without adding headcount.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={CALENDLY}
            data-track-click="MediaCTAClick"
            data-track-params={JSON.stringify({ audience: 'media', surface: 'media-page', content_name: 'hero-demo' })}
            class="clik-btn clik-btn-primary"
          >
            Book a demo <span aria-hidden="true">→</span>
          </a>
          <a href="#media-plans" class="clik-btn clik-btn-secondary">See plans</a>
        </div>

      </div>

      <div class="hidden items-center gap-3 lg:flex" aria-hidden="true">
        {outputs.map((o, i) => (
          <div
            class="relative overflow-hidden rounded-xl"
            style={`width: 132px; aspect-ratio: 9 / 16; border: 1px solid ${o.accent}55; box-shadow: 0 18px 40px rgba(4, 8, 22, 0.45); transform: translateY(${i % 2 ? 14 : -14}px);`}
          >
            <video src={o.src} class="absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline preload="metadata"></video>
            <span
              class="absolute inset-x-0 bottom-0 block px-2 py-1 font-mono uppercase"
              style="font-size: 8px; letter-spacing: 0.1em; color: rgba(249,247,241,.85); background: rgba(6,11,26,.8);"
            >{o.label}</span>
          </div>
        ))}
      </div>
      </div>
    </div>
  </section>

  <!-- [01] Problem -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 01 ]</span>
        <span class="rule"></span>
        <span class="label">THE PROBLEM</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-8" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        The main cut ships. The rest of it doesn’t<span class="clik-period">.</span>
      </h2>
      <p class="font-ui text-clik-cream/70 mb-6" style="font-size: 18px; line-height: 1.6;">
        Everything you record should become ten pieces of content: the recap, the compilation, the vertical cuts, the quote cards. Everyone on the team knows it.
      </p>
      <p class="font-ui text-clik-cream/70 mb-6" style="font-size: 18px; line-height: 1.6;">
        But cutting it falls to whoever has spare hours, which is nobody. The backlog grows every week. Consistency slips across properties, one editor’s caption style here, another’s pacing there. And the video that should have gone up while the moment was fresh goes up eleven days later, or never.
      </p>
      <p class="font-ui text-clik-cream mb-0 font-semibold" style="font-size: 18px; line-height: 1.6;">
        You don’t have a content problem. You have a throughput problem.
      </p>
    </div>
  </section>

  <!-- [02] Works from either end -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 02 ]</span>
        <span class="rule"></span>
        <span class="label">EITHER END</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <!-- Headline left, intro right — uses the full width at a readable measure -->
      <div class="mb-12">
        <h2 class="font-display font-medium text-clik-cream" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        Most tools need a finished cut. Clik works from either end<span class="clik-period">.</span>
        </h2>
        <p class="mt-5 max-w-[92ch] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.6;">
        Start clipping before post finishes, or hand over the produced cut. Same engine, same output.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="bento-card border flex flex-col" style={`${CARD} padding: 32px;`}>
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
            01 · From the raw recording
          </p>
          <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(22px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em;">
            Clips before the edit is even done.
          </h3>
          <p class="font-ui text-clik-cream/70" style="font-size: 16px; line-height: 1.55;">
            Upload the session the day you record. Clik finds the strongest moments across the full runtime and builds the social cuts while your editor is still cutting the main piece. Publish-day videos, ready on publish day.
          </p>
        </div>

        <div class="bento-card border flex flex-col" style={`${CARD} padding: 32px;`}>
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
            02 · From the finished cut
          </p>
          <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(22px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em;">
            Clips that cut to your footage, not stock.
          </h3>
          <p class="font-ui text-clik-cream/70" style="font-size: 16px; line-height: 1.55;">
            Hand Clik the finished cut plus your B-roll library and graphics. Every video cuts away to your own material, in your own style, not a stock reel that could belong to anyone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- [03] Built for teams -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 03 ]</span>
        <span class="rule"></span>
        <span class="label">BUILT FOR TEAMS</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-12" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        One engine. Every property. Every channel<span class="clik-period">.</span>
      </h2>

      <div class="grid gap-5 md:grid-cols-3">
        {teamFeatures.map((cap) => (
          <div class="bento-card border" style={`${CARD} padding: 28px;`}>
            <span
              class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-lg text-sm"
              style={`color: ${cap.accent}; background: ${cap.accent}14; border: 1px solid ${cap.accent}35;`}
              aria-hidden="true"
            >✦</span>
            <h3 class="font-display font-medium text-clik-cream mb-3" style="font-size: clamp(20px, 2.2vw, 24px); line-height: 1.2; letter-spacing: -0.01em;">
              {cap.title}<span class="clik-period">.</span>
            </h3>
            <p class="font-ui text-clik-cream/70" style="font-size: 16px; line-height: 1.6;">
              {cap.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- [04] The weekly cadence -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 04 ]</span>
        <span class="rule"></span>
        <span class="label">THE CADENCE</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-12" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        How teams run on Clik<span class="clik-period">.</span>
      </h2>

      <div class="grid gap-5 md:grid-cols-2">
        {steps.map((step, i) => (
            <div class="bento-card flex flex-col gap-6 border p-6 md:p-7" style={CARD}>
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="font-display font-medium text-clik-cream" style="font-size: 21px; line-height: 1.2; letter-spacing: -0.01em;">
                  {step.title}<span class="clik-period">.</span>
                </h3>
              </div>
              <div class="flex flex-1 flex-col justify-center">
                <StepVisual step={i} client:visible />
              </div>
              <p class="font-ui text-clik-cream/65" style="font-size: 15px; line-height: 1.55;">
                {step.body}
              </p>
            </div>
        ))}
      </div>

      <p class="mt-10 font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.6;">
        Every week. Every property. Without adding headcount.
      </p>
    </div>
  </section>

  <!-- [05] Proof -->
  <section class="px-6 md:px-12 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header">
        <span class="idx">[ 05 ]</span>
        <span class="rule"></span>
        <span class="label">PROOF</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <div class="bento-card border mb-8 p-3" style={CARD}>
        <video
          controls
          preload="metadata"
          playsinline
          poster="/images/testimonials/bobby-mae-poster.jpg"
          class="w-full aspect-video rounded-xl bg-black"
        >
          <source src="/videos/testimonial-bobby-mae.mp4" type="video/mp4" />
        </video>
        <div class="flex items-center gap-3 px-4 pt-5 pb-3">
          <span class="inline-flex h-7 items-center rounded-md border border-clik-cream/15 bg-clik-cream/10 px-2.5 shrink-0">
            <img src="/images/testimonials/mae-media.png" alt="MAE Media" class="h-3 w-auto" loading="lazy" />
          </span>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/70">
            <span class="font-bold text-clik-cream">Bobby</span>
            <span class="text-clik-cream/45"> · Founder, MAE Media</span>
          </p>
        </div>
      </div>

      <div class="bento-card border flex flex-col" style={`${CARD} padding: 28px;`}>
        <p class="font-ui text-clik-cream/85 leading-relaxed" style="font-size: 16px;">
          "Clik finds extra concepts in my footage that a traditional editor would never bother to pull. Same shoot, more deliverables, less time."
        </p>
        <div class="mt-auto pt-6 flex items-center gap-3">
          <span class="inline-flex h-7 items-center rounded-md border border-clik-cream/15 bg-clik-cream/10 px-2 shrink-0">
            <img src="/images/testimonials/mae-media.png" alt="MAE Media" class="h-3 w-auto" loading="lazy" />
          </span>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-clik-cream/70">
            <span class="font-bold text-clik-cream">Bobby</span>
            <span class="text-clik-cream/45"> · Founder, MAE Media</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- [06] Plans — identical to the agency page by design -->
  <section
    id="media-plans"
    data-track-view="MediaPlansView"
    data-track-params={JSON.stringify({ audience: 'media', surface: 'media-page' })}
    class="scroll-mt-24 px-6 md:px-12 py-16 md:py-20"
  >
    <div class="mx-auto max-w-[1200px] mb-10">
      <div class="clik-section-header justify-center">
        <span class="idx">[ 06 ]</span>
        <span class="rule"></span>
        <span class="label">PLANS</span>
      </div>
    </div>
    <div class="mx-auto max-w-[1200px]">
      <h2 class="font-display font-medium text-clik-cream mb-4" style="font-size: clamp(32px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.02em;">
        Built for your volume<span class="clik-period">.</span>
      </h2>
      <p class="font-ui text-clik-cream/70 mb-12 max-w-2xl mx-auto" style="font-size: 18px; line-height: 1.6;">
        Transparent floor. Custom from there, scaled to your monthly output.
      </p>

      <div
        class="relative rounded-[17px] p-px text-left"
        style="background: linear-gradient(120deg, rgba(84, 129, 232, 0.55), rgba(84, 129, 232, 0.10) 30%, rgba(249, 131, 142, 0.10) 70%, rgba(249, 131, 142, 0.5));"
      >
      <div
        class="bento-card relative overflow-hidden"
        style="background: #101B3E; color: var(--clik-cream); padding: clamp(28px, 4vw, 40px);"
      >
        <div class="mb-8 pb-8 border-b border-clik-cream/12">
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce font-bold">
            Starting at
          </p>
          <div class="flex items-baseline gap-2">
            <span class="font-display font-medium text-clik-cream" style="font-size: clamp(48px, 7vw, 72px); line-height: 1; letter-spacing: -0.03em;">
              $499
            </span>
            <span class="font-mono text-[14px] uppercase tracking-[0.14em] text-clik-cream/55">
              / mo
            </span>
          </div>
          <p class="mt-3 font-ui text-clik-cream/70" style="font-size: 15px; line-height: 1.5;">
            Volume-based, scaling with your monthly video output. Cancel anytime.
          </p>
        </div>

        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.14em] text-clik-royce">
          Every plan includes:
        </p>
        <ul class="space-y-3 mb-8">
          {planIncludes.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-4 w-4 shrink-0 text-clik-royce" viewBox="0 0 16 16" fill="none">
                <path d="M3 8.5L6.5 12L13 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="font-ui text-clik-cream/85" style="font-size: 16px; line-height: 1.55;">{item}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <a
            href={CALENDLY}
            target="_blank"
            rel="noopener noreferrer"
            data-track-click="MediaCTAClick"
            data-track-params={JSON.stringify({ audience: 'media', surface: 'media-page', content_name: 'plans-demo' })}
            class="clik-btn clik-btn-primary"
          >
            Book a demo <span aria-hidden="true">→</span>
          </a>
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-cream/55">
            for custom quotes & higher volume.
          </span>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- [07] Final CTA -->
  <section class="px-6 md:px-12 py-16 md:py-28">
    <div class="mx-auto max-w-[1200px]">
      <div class="clik-section-header mb-8">
        <span class="idx">[ 07 ]</span>
        <span class="rule"></span>
        <span class="label">START</span>
      </div>
      <div
        class="on-midnight relative overflow-hidden"
        style="background: #13204A; border: 1px solid rgba(249, 247, 241, 0.10); border-radius: 12px; padding: clamp(48px, 7vw, 96px) clamp(24px, 5vw, 64px); color: var(--clik-cream);"
      >
        <div
          class="glow -left-32 -top-32 h-[420px] w-[640px]"
          style="background: radial-gradient(closest-side, rgba(84, 129, 232, 0.20), transparent 72%);"
          aria-hidden="true"
        ></div>
        <h2 class="font-display font-medium text-clik-cream" style="font-size: clamp(40px, 6vw, 68px); line-height: 1; letter-spacing: -0.02em;">
          3× your output without adding headcount<span class="clik-period">.</span>
        </h2>
        <p class="mt-6 max-w-[52ch] font-ui text-clik-cream/70" style="font-size: 18px; line-height: 1.55;">
          Bring one recording to a demo and watch the videos come back. Plans start at $499/mo and scale with your monthly volume.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={CALENDLY}
            data-track-click="MediaCTAClick"
            data-track-params={JSON.stringify({ audience: 'media', surface: 'media-page', content_name: 'closing-demo' })}
            class="clik-btn clik-btn-light"
          >
            Book a demo <span aria-hidden="true">→</span>
          </a>
          <a href="#media-plans" class="clik-btn cta-ghost">
            See plans
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .cta-ghost {
    background: transparent;
    color: var(--clik-cream);
    border: 1px solid rgba(249, 247, 241, 0.25);
  }
  .cta-ghost:hover {
    border-color: var(--clik-cream);
  }
</style>
