---
const testimonials = [
  {
    quote: "Finding good editors is the only reason I can't scale. Clik solves that problem.",
    author: "Content Agency",
    handle: "$30K MRR",
    accent: '#5481E8',
  },
  {
    quote: "This totally changes how we work. With drafts ready instantly, our creative directors take projects deeper and iterate faster. Our editors just make finishing touches. Now we can scale without hiring more editors.",
    author: "Feed Studios LA",
    handle: "Content Agency",
    accent: '#DC1DD9',
  },
  {
    quote: "This just turned an 8 hour edit process into 2. I went from opening my computer to posting on YouTube in 2 hours. It was magical.",
    author: "Matt Ragland",
    handle: "YouTuber",
    accent: '#F9838E',
  },
  {
    quote: "This will totally change how people create content.",
    author: "Zach Neman",
    handle: "@cheffinwithzach",
    accent: '#D4A853',
  },
  {
    quote: "Clik has completely changed not only how I edit but how I film. What used to take over two hours now takes 20 minutes, and I enjoy the entire process around cooking content much more now.",
    author: "Randy Stoever",
    handle: "@hotoffthestoever",
    accent: '#F9838E',
  },
  {
    quote: "I've tried so many AI content tools; Clik is my favorite by far.",
    author: "Gigi Robinson",
    handle: "@itsgigirobinson",
    accent: '#DC1DD9',
  },
];

// Split testimonials into two rows for the marquee
// With 4 items, put 2 in each row. When more are added, split evenly.
const mid = Math.ceil(testimonials.length / 2);
const row1 = testimonials.slice(0, mid);
const row2 = testimonials.slice(mid);
---

<section class="py-24 overflow-hidden">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-16 text-center">
      <h2 class="text-4xl font-bold text-white md:text-5xl">
        Teams and creators are<br class="hidden md:block" />
        shipping faster than ever.
      </h2>
    </div>
  </div>

  {/* Desktop: two-row marquee */}
  <div class="hidden md:block space-y-4">
    {/* Row 1 — scrolls left */}
    <div class="marquee-row group" style="--marquee-direction: normal;">
      <div class="marquee-track">
        {[...row1, ...row1, ...row1, ...row1].map((t, i) => (
          <div
            class="marquee-card flex-shrink-0 w-[380px] rounded-xl bg-white/[0.03] p-5"
          >
            <p class="text-[15px] leading-relaxed text-zinc-300 mb-3">"{t.quote}"</p>
            <p class="text-sm">
              <span class="font-medium text-white">{t.author}</span>
              <span class="text-zinc-500"> · {t.handle}</span>
            </p>
          </div>
        ))}
      </div>
    </div>

    {/* Row 2 — scrolls right */}
    <div class="marquee-row group" style="--marquee-direction: reverse;">
      <div class="marquee-track">
        {[...row2, ...row2, ...row2, ...row2].map((t, i) => (
          <div
            class="marquee-card flex-shrink-0 w-[380px] rounded-xl bg-white/[0.03] p-5"
          >
            <p class="text-[15px] leading-relaxed text-zinc-300 mb-3">"{t.quote}"</p>
            <p class="text-sm">
              <span class="font-medium text-white">{t.author}</span>
              <span class="text-zinc-500"> · {t.handle}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Mobile: single row, swipe-scrollable with auto-scroll */}
  <div class="md:hidden">
    <div class="marquee-row group" style="--marquee-direction: normal;">
      <div class="marquee-track">
        {[...testimonials, ...testimonials, ...testimonials].map((t, i) => (
          <div
            class="marquee-card flex-shrink-0 w-[300px] rounded-xl bg-white/[0.03] p-5"
          >
            <p class="text-[15px] leading-relaxed text-zinc-300 mb-3">"{t.quote}"</p>
            <p class="text-sm">
              <span class="font-medium text-white">{t.author}</span>
              <span class="text-zinc-500"> · {t.handle}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-row {
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: marquee-scroll 50s linear infinite;
    animation-direction: var(--marquee-direction, normal);
  }

  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
