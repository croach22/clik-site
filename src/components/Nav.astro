---
const navLinks = [
  { label: 'Formats',      href: '/#formats'      },
  { label: 'Pricing',      href: '/#pricing'      },
  { label: 'Learn',        href: '/docs'           },
];

const agents = [
  { label: 'Edit Agent',      href: '/#feature-edit',           accent: '#5481E8', isNew: false },
  { label: 'Workflow Agent',   href: '/#feature-workflow-agent', accent: '#5481E8', isNew: true },
  { label: 'Brainstorm Agent', href: '/#feature-plan',           accent: '#DC1DD9', isNew: false },
];
---

<nav class="fixed left-0 right-0 z-50 border-b border-white/5 bg-brand-bg/80 backdrop-blur-md" style="top: 0px;">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">

    <a href="/" class="flex items-center">
      <img src="/logo-white.svg" alt="Clik" class="h-7 w-auto" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">

      <!-- How it works dropdown -->
      <div class="group relative">
        <button class="flex items-center gap-1 text-sm text-brand-cream/60 transition-colors hover:text-brand-cream">
          How it works
          <svg class="w-3 h-3 opacity-50 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none">
            <path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:pointer-events-auto group-hover:opacity-100">
          <div class="rounded-xl border border-white/8 bg-zinc-900/95 backdrop-blur-lg p-1.5 shadow-xl shadow-black/40 min-w-[200px]">
            {agents.map((agent) => (
              <a
                href={agent.href}
                class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm text-brand-cream/70 transition-colors hover:bg-white/5 hover:text-brand-cream"
              >
                {agent.label}
                {agent.isNew && (
                  <span class="rounded-full px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider" style="background: #5481E820; color: #5481E8;">
                    New
                  </span>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-brand-cream/60 transition-colors hover:text-brand-cream"
        >
          {link.label}
        </a>
      ))}

      <a
        href="/founding-creators"
        class="text-sm font-medium transition-colors hover:text-brand-cream"
        style="color: #D4A853;"
      >
        Founding Creators
      </a>

    </div>

    <div class="flex items-center gap-3">
      <!-- Book a Demo (desktop only) -->
      <a
        href="https://calendly.com/clikphotos/clik-agency-demo"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-full border border-white/10 px-4 py-2.5 text-sm font-medium text-brand-cream/70 transition-colors hover:border-white/20 hover:text-brand-cream md:inline-block"
      >
        Book a Demo
      </a>
      <!-- CTA (desktop only) -->
      <a
        href="https://app.clik.vision/sign-up"
        class="group relative hidden overflow-hidden rounded-full bg-brand-cream px-4 py-2.5 text-sm font-semibold text-zinc-950 transition-all hover:scale-105 hover:text-white md:inline-block"
      >
        <span class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: linear-gradient(135deg, #F9838E, #DC1DD9, #5481E8)" />
        <span class="relative">Start for Free</span>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-lg md:hidden"
        aria-label="Open menu"
      >
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="#F9F7F1" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div id="mobile-menu" class="fixed inset-0 z-[55] hidden flex-col bg-brand-bg/95 backdrop-blur-lg">
  <div class="flex items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center">
      <img src="/logo-white.svg" alt="Clik" class="h-7 w-auto" />
    </a>
    <button id="mobile-menu-close" class="flex h-10 w-10 items-center justify-center rounded-lg" aria-label="Close menu">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M1 1l14 14M15 1L1 15" stroke="#F9F7F1" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <div class="flex flex-1 flex-col items-center justify-center gap-10">
    <div class="flex flex-col items-center gap-3">
      <span class="text-2xl font-semibold text-brand-cream/80 mb-1">How it works</span>
      {agents.map((agent) => (
        <a
          href={agent.href}
          class="mobile-menu-link text-base text-brand-cream/50 transition-colors hover:text-brand-cream"
        >
          {agent.label}
        </a>
      ))}
    </div>
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-menu-link text-2xl font-semibold text-brand-cream/80 transition-colors hover:text-brand-cream"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/founding-creators"
      class="mobile-menu-link text-2xl font-semibold transition-colors hover:text-brand-cream"
      style="color: #D4A853;"
    >
      Founding Creators
    </a>

    <a
      href="https://app.clik.vision/sign-up"
      class="mobile-menu-link mt-4 rounded-full bg-brand-cream px-8 py-3.5 text-base font-semibold text-zinc-950"
    >
      Start for Free
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const close = document.getElementById('mobile-menu-close');
  const links = menu?.querySelectorAll('.mobile-menu-link');

  function openMenu() {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  links?.forEach((link) => link.addEventListener('click', closeMenu));
</script>
