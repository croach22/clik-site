---
const before = [
  'Hours lost to manual editing',
  'Backlog of footage that never ships',
  'Editing is the bottleneck between shoot and publish',
  'Stuck in the timeline instead of creating',
];

const after = [
  'Rough cuts ready before you open the timeline',
  'Turn one shoot day into a week of content',
  'Ship faster without adding hours or headcount',
  'Stay creative, finish faster',
];
---

<section class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-16 text-center">
      <h2 class="text-4xl font-bold text-white md:text-5xl">
        Ship more. Edit less.
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <!-- Before -->
      <div class="rounded-2xl border border-red-500/10 bg-red-500/5 p-8">
        <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-red-400">Before Clik</p>
        <ul class="space-y-4">
          {before.map((item) => (
            <li class="flex items-start gap-3 text-zinc-400">
              <span class="mt-0.5 text-red-500">✕</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- After -->
      <div class="rounded-2xl border border-emerald-500/10 bg-emerald-500/5 p-8">
        <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-emerald-400">After Clik</p>
        <ul class="space-y-4">
          {after.map((item) => (
            <li class="flex items-start gap-3 text-zinc-100">
              <span class="mt-0.5 text-emerald-400">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
