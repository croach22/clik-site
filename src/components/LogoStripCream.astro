---
// Thin trust bar immediately below the hero — no section header, no idx
// (same "quiet band" treatment as the old AgencyBandCream).
// Only two brand logo assets exist today (white knockouts → midnight chips);
// the rest of the strip is text-mark creator names until more logos are sourced.
const logos = [
  { src: '/images/testimonials/feed-studios.png', alt: 'Feed Studios' },
  { src: '/images/testimonials/mae-media.png', alt: 'MAE Media' },
];

const textMarks = ['Matt Ragland', 'Gigi Robinson', '@cheffinwithzach', '@hotoffthestoever'];
---

<section id="logo-strip" class="border-y border-clik-midnight/10 bg-clik-bone/40">
  <div class="mx-auto max-w-[1200px] px-6 py-6 md:px-12 md:py-7">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 md:gap-x-12">
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-clik-midnight/45">
        Runs content for
      </span>
      {logos.map((logo) => (
        <span class="inline-flex h-8 items-center rounded-md bg-clik-midnight px-3">
          <img src={logo.src} alt={logo.alt} class="h-3.5 w-auto" loading="lazy" />
        </span>
      ))}
      {textMarks.map((name) => (
        <span class="font-mono text-[12px] uppercase tracking-[0.14em] text-clik-midnight/55">
          {name}
        </span>
      ))}
    </div>
  </div>
</section>
