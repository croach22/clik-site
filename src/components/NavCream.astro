---
// Midnight nav for cream pages — inverted contrast against the cream body.
// Flat nav: Pricing + Blog. Solutions dropdown (creators/agencies/media teams)
// is phase two — build after the single landing page is converting.
// Founding Creators lives in the footer, not the primary nav.

// Pricing is audience-contextual: on the agencies page, "Pricing" jumps to the
// agency plans section. Everywhere else it goes to the home pricing tier grid.
const onAgenciesPage = Astro.url.pathname.startsWith('/use-cases/agencies');
const pricingHref = onAgenciesPage ? '#agency-plans' : '/#pricing';

const navLinks = [
  {
    label: 'Pricing',
    href: pricingHref,
    // Clicking Pricing while on the agencies page is a very high intent signal.
    track: onAgenciesPage ? 'AgencyPricingNavClick' : undefined,
    trackParams: onAgenciesPage ? { audience: 'agency', surface: 'nav' } : undefined,
  },
  { label: 'Blog', href: '/blog' },
];
---

<nav class="on-midnight fixed left-0 right-0 top-1.5 z-50 px-3 md:top-2.5 md:px-6">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between border border-clik-cream/10 p-2 backdrop-blur-md md:p-2.5" style="background: rgba(14, 24, 52, 0.92); border-radius: 18px;">

    <a href="/" class="flex items-center">
      <img src="/logo-white.svg" alt="Clik" class="h-5 w-auto md:h-6" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-track-click={link.track}
          data-track-params={link.trackParams ? JSON.stringify(link.trackParams) : undefined}
          class="font-ui text-sm font-bold text-clik-cream/70 transition-colors hover:text-clik-cream"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://app.clik.vision"
        class="hidden font-ui text-sm font-bold text-clik-cream/70 transition-colors hover:text-clik-cream md:inline-block"
      >
        Sign in
      </a>
      <a
        href="https://app.clik.vision/sign-up"
        class="clik-btn clik-btn-light hidden md:inline-flex"
      >
        Start for free <span aria-hidden="true">→</span>
      </a>
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-lg md:hidden"
        aria-label="Open menu"
      >
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="#F9F7F1" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu — bottom-sheet drawer on cream surface, brand language -->
<div
  id="mobile-menu-backdrop"
  class="pointer-events-none fixed inset-0 z-[55] bg-black/55 opacity-0 transition-opacity duration-200 ease-out md:hidden"
  aria-hidden="true"
></div>

<div
  id="mobile-menu-drawer"
  class="mobile-menu-drawer fixed inset-x-0 bottom-0 z-[60] flex max-h-[75vh] translate-y-full flex-col rounded-t-[20px] transition-transform duration-[280ms] ease-out md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
>
  <!-- Drag handle pill -->
  <div class="flex shrink-0 justify-center pt-3 pb-2">
    <span class="block h-1 w-9 rounded-full bg-clik-midnight/20" aria-hidden="true"></span>
  </div>

  <!-- Close button -->
  <button
    id="mobile-menu-close"
    class="absolute right-3 top-3 flex h-10 w-10 items-center justify-center text-clik-midnight/65 transition-colors hover:text-clik-midnight"
    aria-label="Close menu"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>

  <!-- Scrollable nav content -->
  <nav class="flex-1 overflow-y-auto px-6 pb-6 pt-3">
    <a
      href={pricingHref}
      data-track-click={onAgenciesPage ? 'AgencyPricingNavClick' : undefined}
      data-track-params={onAgenciesPage ? JSON.stringify({ audience: 'agency', surface: 'mobile-drawer' }) : undefined}
      class="mobile-menu-link mobile-menu-row stagger-row"
      style="--i: 0"
    >
      <span>Pricing</span>
      <svg class="mobile-menu-chevron" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </a>
    <a href="/blog" class="mobile-menu-link mobile-menu-row stagger-row" style="--i: 1">
      <span>Blog</span>
      <svg class="mobile-menu-chevron" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </a>
  </nav>

  <!-- Pinned bottom CTA -->
  <div class="shrink-0 border-t border-clik-midnight/10 px-6 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
    <div class="flex items-center gap-4">
      <a href="https://app.clik.vision" class="mobile-menu-link font-ui text-sm font-bold text-clik-midnight/65 transition-colors hover:text-clik-midnight">
        Sign in
      </a>
      <a href="https://app.clik.vision/sign-up" class="mobile-menu-link clik-btn clik-btn-primary ml-auto">
        Start for free <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .mobile-menu-drawer {
    background: #FAFAF7;
    color: var(--clik-midnight);
    box-shadow: 0 -1px 0 rgba(14, 24, 52, 0.08); /* hairline above the top edge, subtle */
  }

  /* Nav rows — destination label in display/serif treatment */
  .mobile-menu-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 56px;
    padding: 10px 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--clik-midnight);
    background: transparent;
    border: none;
    cursor: pointer;
    border-bottom: 0.5px solid rgba(14, 24, 52, 0.12); /* hairline divider */
  }
  /* No divider on the final row in the nav */
  nav > .mobile-menu-row:last-child {
    border-bottom: none;
  }
  .mobile-menu-row:active {
    background: rgba(14, 24, 52, 0.03);
  }

  .mobile-menu-chevron {
    width: 14px;
    height: 14px;
    opacity: 0.45;
    color: currentColor;
  }

  /* Stagger-fade animation on open — rows fade in 40ms apart, 200ms each */
  .mobile-menu-drawer .stagger-row {
    opacity: 0;
    transform: translateY(8px);
  }
  .mobile-menu-drawer.drawer-open .stagger-row {
    animation: mobileNavStagger 200ms ease-out forwards;
    animation-delay: calc(var(--i, 0) * 40ms);
  }
  @keyframes mobileNavStagger {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const close = document.getElementById('mobile-menu-close');
  const links = drawer?.querySelectorAll('.mobile-menu-link');

  function openMenu() {
    drawer?.classList.remove('translate-y-full');
    drawer?.classList.add('drawer-open');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    drawer?.classList.add('translate-y-full');
    drawer?.classList.remove('drawer-open');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  links?.forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('drawer-open')) {
      closeMenu();
    }
  });
</script>
